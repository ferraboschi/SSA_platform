"use client";

import {
  useState,
  useMemo,
  useEffect,
  useRef,
  type CSSProperties,
  type ReactNode,
} from "react";
import Image from "next/image";
import winnersRaw from "@/lib/msc2026-data.json";

// ─── Types ───────────────────────────────────────────────────────────────────

type MedalKey =
  | "platinum"
  | "double_gold"
  | "gold"
  | "silver"
  | "best_design"
  | "good_design"
  | "magnifica"
  | "good_with";
type SessionKey = "nihonshu" | "shochu" | "pairing" | "design";
type LangKey = "it" | "en" | "ja";
type RegionKey =
  | "hokkaido_tohoku"
  | "kanto"
  | "chubu_hokuriku"
  | "kinki"
  | "chugoku_shikoku"
  | "kyushu_okinawa"
  | "altro";

interface Winner {
  session: SessionKey;
  category: string;
  cat_code: string;
  medal: MedalKey;
  magnifica_tasting: boolean;
  reg_id: string;
  number: number;
  name: string;
  original_name: string;
  company_en: string;
  company_jp: string;
  // enrichment (all optional — data is sparse)
  prefecture?: string;
  region?: string;
  country?: string;
  polishing_rate?: number | string;
  smv?: number | string;
  alcohol?: number | string;
  price?: number | string;
  currency?: string;
  product_type?: string;
  bubble?: string;
  shochu_type?: string;
  distillation?: string;
  years_aging?: number | string;
  brewery_website?: string;
  brewery_founded?: number | string;
  koji?: string[];
  koji_rice?: string[];
  rice?: string[];
  yeast?: string[];
  aroma?: string[];
  taste?: string[];
  finishing?: string[];
  food_pairing?: string[];
}

const winners = winnersRaw as Winner[];

// ─── Medal config ────────────────────────────────────────────────────────────

const MEDAL_RANK: Record<MedalKey, number> = {
  platinum: 0,
  double_gold: 1,
  gold: 2,
  silver: 3,
  best_design: 0,
  good_design: 1,
  magnifica: 0,
  good_with: 1,
};

interface MedalMeta {
  it: string;
  en: string;
  ja: string;
  pillBg: string;
  pillText: string;
  dot: string;
}

