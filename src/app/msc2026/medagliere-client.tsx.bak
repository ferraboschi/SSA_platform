// ─── Helpers ─────────────────────────────────────────────────────────────────

function medalLabel(m: MedalKey, lang: LangKey) {
  return MEDAL_META[m][lang];
}
function companyName(w: Winner, lang: LangKey) {
  return lang === "ja" && w.company_jp ? w.company_jp : w.company_en;
}
function medalImageFor(w: Winner): string {
  const { session, medal, cat_code } = w;
  if (session === "nihonshu" || session === "shochu") {
    const tier = TASTING_TIER[medal];
    if (tier) return `/medals/${session}_${tier}.png`;
  } else if (session === "design") {
    if (medal === "good_design") return "/medals/good_design.png";
    if (medal === "best_design" && BEST_DESIGN_CODES.has(cat_code)) return `/medals/best_design_${cat_code}.png`;
  } else if (session === "pairing") {
    if (medal === "magnifica" && PAIRING_ART_CODES.has(cat_code)) return `/medals/pairing_magnifica_${cat_code}.png`;
    if (medal === "good_with" && PAIRING_ART_CODES.has(cat_code)) return `/medals/pairing_goodwith_${cat_code}.png`;
  }
  return MEDAL_PLACEHOLDER;
}
function hasMedalArt(w: Winner): boolean {
  return medalImageFor(w) !== MEDAL_PLACEHOLDER;
}
function magnificaTastingImageFor(w: Winner): string | null {
  if (!w.magnifica_tasting) return null;
  if (w.session === "nihonshu" && MT_CODES_NIHONSHU.has(w.cat_code)) return `/medals/magnifica_tasting_nihonshu_${w.cat_code}.png`;
  if (w.session === "shochu" && MT_CODES_SHOCHU.has(w.cat_code)) return `/medals/magnifica_tasting_shochu_${w.cat_code}.png`;
  return null;
}
function regionLabel(key: RegionKey, lang: LangKey) {
  return REGION_META[key][lang];
}
function regionLabelOf(w: Winner, lang: LangKey) {
  return regionLabel(regionKeyOf(w), lang);
}
function asArray(v: unknown): string[] {
  if (Array.isArray(v)) return v.map(String).filter(Boolean);
  if (v === null || v === undefined || v === "") return [];
  return [String(v)];
}
function present(v: unknown): boolean {
  if (v === null || v === undefined || v === "") return false;
  if (Array.isArray(v)) return v.length > 0;
  return true;
}
function formatPct(v: number | string) {
  return `${v}%`;
}
function formatSmv(v: number | string) {
  const n = Number(v);
  if (!isFinite(n)) return String(v);
  return n > 0 ? `+${n}` : `${n}`;
}
function formatPrice(price: number | string, currency?: string) {
  const n = Number(price);
  const sym = currency === "JPY" ? "¥" : currency === "EUR" ? "€" : currency === "USD" ? "$" : currency ? `${currency} ` : "";
  if (!isFinite(n)) return `${sym}${price}`;
  return `${sym}${n.toLocaleString("it-IT", { maximumFractionDigits: 0 })}`;
}

// ─── Medal pill ──────────────────────────────────────────────────────────────

function MedalPill({ medal, lang }: { medal: MedalKey; lang: LangKey }) {
  const m = MEDAL_META[medal];
  return (
    <span
      style={{
        display: "inline-flex",
        alignItems: "center",
        gap: 5,
        background: m.pillBg,
        color: m.pillText,
        fontSize: 12,
        fontWeight: 600,
        borderRadius: 999,
        padding: "3px 9px",
        whiteSpace: "nowrap",
        lineHeight: 1.4,
      }}
    >
      <span style={{ width: 7, height: 7, borderRadius: "50%", background: m.dot, flexShrink: 0 }} />
      {m[lang]}
    </span>
  );
}

// ─── Product row ─────────────────────────────────────────────────────────────

function ProductRow({
  winner,
  lang,
  showCategory,
  onOpen,
  onRegion,
}: {
  winner: Winner;
  lang: LangKey;
  showCategory: boolean;
  onOpen: (id: string) => void;
  onRegion: (key: RegionKey) => void;
}) {
  const imgSrc = medalImageFor(winner);
  const m = MEDAL_META[winner.medal];
  const rk = regionKeyOf(winner);
  const place = winner.prefecture
    ? `${winner.prefecture} · ${regionLabel(rk, lang)}`
    : regionLabel(rk, lang);

  return (
    <div
      className="msc-row msc-anim"
      role="button"
      tabIndex={0}
      onClick={() => onOpen(winner.reg_id)}
      onKeyDown={(e) => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          onOpen(winner.reg_id);
        }
      }}
      style={{
        display: "flex",
        alignItems: "center",
        gap: 14,
        background: "#fff",
        border: "1px solid #e9ebef",
        borderRadius: 12,
        padding: "13px 16px",
        boxShadow: "0 1px 2px rgba(16,24,40,.04)",
        cursor: "pointer",
      }}
    >
      <div
        style={{
          width: 44,
          height: 44,
          borderRadius: 10,
          flexShrink: 0,
          overflow: "hidden",
          background: m.pillBg,
          display: "flex",
          alignItems: "center",
          justifyContent: "center",
        }}
      >
        <Image src={imgSrc} alt={medalLabel(winner.medal, lang)} width={44} height={44} style={{ objectFit: "contain" }} />
      </div>

      <div style={{ flex: 1, minWidth: 0 }}>
        <div style={{ fontSize: 14, fontWeight: 700, color: "#101828", overflow: "hidden", textOverflow: "ellipsis", whiteSpace: "nowrap" }}>
          {winner.name}
        </div>
        <div style={{ fontSize: 12, color: "#667085", marginTop: 2, overflow: "hidden", textOverflow: "ellipsis", whiteSpace: "nowrap" }}>
          {companyName(winner, lang)}
          {"  ·  "}
          <span
            className="msc-link"
            role="link"
            tabIndex={0}
            onClick={(e) => {
              e.stopPropagation();
              onRegion(rk);
            }}
            onKeyDown={(e) => {
              if (e.key === "Enter") {
                e.stopPropagation();
                onRegion(rk);
              }
            }}
            style={{ color: "#475467", cursor: "pointer" }}
          >
            {place}
          </span>
        </div>
      </div>

      <div style={{ display: "flex", flexDirection: "column", alignItems: "flex-end", gap: 5, flexShrink: 0 }}>
        <MedalPill medal={winner.medal} lang={lang} />
        {showCategory && (
          <span
            style={{
              fontSize: 11,
              fontWeight: 600,
              color: "#475467",
              background: "#f2f4f7",
              borderRadius: 6,
              padding: "2px 7px",
              maxWidth: 170,
              overflow: "hidden",
              textOverflow: "ellipsis",
              whiteSpace: "nowrap",
            }}
          >
            {winner.category}
          </span>
        )}
      </div>
      <span style={{ color: "#cbd2dc", fontSize: 18, flexShrink: 0 }}>›</span>
    </div>
  );
}

// ─── Macro-area card (hub) ───────────────────────────────────────────────────

function MacroAreaCard({
  session,
  count,
  catCount,
  catUnit,
  lang,
  onSelect,
}: {
  session: SessionKey;
  count: number;
  catCount: number;
  catUnit: string;
  lang: LangKey;
  onSelect: () => void;
}) {
  const s = SESSION_META[session];
  return (
    <button
      className="msc-card msc-anim"
      onClick={onSelect}
      style={{
        display: "block",
        textAlign: "left",
        padding: 0,
        border: "1px solid #e9ebef",
        borderRadius: 14,
        overflow: "hidden",
        background: "#fff",
        cursor: "pointer",
        boxShadow: "0 1px 2px rgba(16,24,40,.04)",
      }}
    >
      <div style={{ height: 56, background: s.wash, borderBottom: `1px solid ${s.accent}22` }} />
      <div style={{ padding: 18 }}>
        <div style={{ fontSize: 21, fontWeight: 700, color: "#101828", lineHeight: 1.15 }}>
          {s[lang]}
        </div>
        <div style={{ fontSize: 12, color: "#98a2b3", marginTop: 2 }}>{s.jaName}</div>
        <div style={{ display: "flex", alignItems: "baseline", gap: 6, marginTop: 14 }}>
          <span style={{ fontSize: 28, fontWeight: 700, color: s.accent, lineHeight: 1 }}>{count}</span>
          <span style={{ fontSize: 12, fontWeight: 600, color: "#8a93a3" }}>{UI[lang].premiati}</span>
        </div>
        <div style={{ fontSize: 12, color: "#667085", marginTop: 4 }}>
          {catCount} {catUnit}
        </div>
        <div style={{ display: "flex", gap: 5, marginTop: 12 }}>
          {SESSION_MEDALS[session].map((mk) => (
            <span key={mk} style={{ width: 9, height: 9, borderRadius: "50%", background: MEDAL_META[mk].dot }} title={MEDAL_META[mk][lang]} />
          ))}
        </div>
      </div>
    </button>
  );
}

// ─── Special awards strip (hub) ──────────────────────────────────────────────

function SpecialAwardsStrip({
  lang,
  platinumCount,
  bestDesignCount,
  magnifica,
  onEnterArea,
  onOpenProduct,
}: {
  lang: LangKey;
  platinumCount: number;
  bestDesignCount: number;
  magnifica: Winner[];
  onEnterArea: (s: SessionKey, medal: MedalKey) => void;
  onOpenProduct: (id: string) => void;
}) {
  const t = UI[lang];
  const featureCard = (
    eyebrow: string,
    big: number,
    label: string,
    dot: string,
    cta: () => void
  ) => (
    <button
      className="msc-card msc-anim msc-award-card"
      onClick={cta}
      style={{
        textAlign: "left",
        flex: "0 0 200px",
        minWidth: 0,
        background: "#fff",
        border: "1px solid #e9ebef",
        borderRadius: 14,
        padding: 16,
        cursor: "pointer",
        boxShadow: "0 1px 2px rgba(16,24,40,.04)",
      }}
    >
      <div style={{ fontSize: 11, fontWeight: 600, color: "#8a93a3" }}>{eyebrow}</div>
      <div style={{ display: "flex", alignItems: "center", gap: 8, marginTop: 8 }}>
        <span style={{ width: 11, height: 11, borderRadius: "50%", background: dot }} />
        <span style={{ fontSize: 26, fontWeight: 700, color: "#101828", lineHeight: 1 }}>{big}</span>
      </div>
      <div style={{ fontSize: 13, fontWeight: 600, color: "#475467", marginTop: 6 }}>{label}</div>
      <div style={{ fontSize: 12, fontWeight: 600, color: "#1e3a8a", marginTop: 10 }}>{t.vediTutti} →</div>
    </button>
  );

  return (
    <div style={{ marginBottom: 28 }}>
      <SectionLabel>{t.premiSpeciali}</SectionLabel>
      <div className="msc-special-strip">
        {featureCard(t.highestHonour, platinumCount, MEDAL_META.platinum[lang], MEDAL_META.platinum.dot, () =>
          onEnterArea("nihonshu", "platinum")
        )}

        {magnifica.map((w) => (
          <button
            key={w.reg_id}
            className="msc-card msc-anim msc-award-card"
            onClick={() => onOpenProduct(w.reg_id)}
            style={{
              textAlign: "left",
              flex: "0 0 200px",
              minWidth: 0,
              background: "#fff",
              border: "1px solid #e9ebef",
              borderRadius: 14,
              padding: 16,
              cursor: "pointer",
              boxShadow: "0 1px 2px rgba(16,24,40,.04)",
            }}
          >
            <div style={{ fontSize: 11, fontWeight: 600, color: "#be185d", textTransform: "uppercase", letterSpacing: ".03em" }}>
              {w.category}
            </div>
            <div style={{ fontSize: 14, fontWeight: 700, color: "#101828", marginTop: 8, overflow: "hidden", textOverflow: "ellipsis", whiteSpace: "nowrap" }}>
              {w.name}
            </div>
            <div style={{ fontSize: 12, color: "#667085", marginTop: 2, overflow: "hidden", textOverflow: "ellipsis", whiteSpace: "nowrap" }}>
              {companyName(w, lang)}
            </div>
            <div style={{ marginTop: 10 }}>
              <MedalPill medal="magnifica" lang={lang} />
            </div>
          </button>
        ))}

        {featureCard(t.bestLabel, bestDesignCount, MEDAL_META.best_design[lang], MEDAL_META.best_design.dot, () =>
          onEnterArea("design", "best_design")
        )}
      </div>
    </div>
  );
}

// ─── Small shared bits ───────────────────────────────────────────────────────

function SectionLabel({ children }: { children: ReactNode }) {
  return (
    <div style={{ display: "flex", alignItems: "center", gap: 12, marginBottom: 14 }}>
      <span style={{ fontSize: 12, fontWeight: 700, color: "#475467", textTransform: "uppercase", letterSpacing: ".05em" }}>
        {children}
      </span>
      <div style={{ flex: 1, height: 1, background: "#e7eaef" }} />
    </div>
  );
}

function FilterChip({ label, onRemove }: { label: string; onRemove: () => void }) {
  return (
    <span
      style={{
        display: "inline-flex",
        alignItems: "center",
        gap: 6,
        background: "#eef1f6",
        color: "#475467",
        fontSize: 12,
        fontWeight: 600,
        borderRadius: 999,
        padding: "3px 6px 3px 10px",
      }}
    >
      {label}
      <button
        onClick={onRemove}
        aria-label="Rimuovi filtro"
        style={{ border: "none", background: "#dde3ee", color: "#475467", borderRadius: "50%", width: 16, height: 16, cursor: "pointer", fontSize: 11, lineHeight: 1, display: "flex", alignItems: "center", justifyContent: "center" }}
      >
        ✕
      </button>
    </span>
  );
}

// ─── Region filter ───────────────────────────────────────────────────────────

function RegionFilter({
  activeRegion,
  counts,
  accent,
  lang,
  onChange,
}: {
  activeRegion: RegionKey | "all";
  counts: Record<string, number>;
  accent: string;
  lang: LangKey;
  onChange: (key: RegionKey | "all") => void;
}) {
  const [open, setOpen] = useState(false);
  const t = UI[lang];
  const active = activeRegion !== "all";
  const label = active ? regionLabel(activeRegion as RegionKey, lang) : t.allRegions;

  return (
    <div style={{ position: "relative" }}>
      <button
        onClick={() => setOpen((o) => !o)}
        style={{
          display: "inline-flex",
          alignItems: "center",
          gap: 6,
          border: `1px solid ${active ? accent : "#d7dbe2"}`,
          background: "#fff",
          color: active ? accent : "#475467",
          borderRadius: 9,
          padding: "7px 12px",
          fontSize: 13,
          fontWeight: 600,
          cursor: "pointer",
          whiteSpace: "nowrap",
        }}
      >
        {t.region}: {label} <span style={{ fontSize: 10, opacity: 0.7 }}>▾</span>
      </button>

      {open && (
        <>
          <div onClick={() => setOpen(false)} style={{ position: "fixed", inset: 0, zIndex: 50 }} />
          <div
            style={{
              position: "absolute",
              top: "calc(100% + 6px)",
              left: 0,
              zIndex: 51,
              minWidth: 240,
              background: "#fff",
              border: "1px solid #e9ebef",
              borderRadius: 12,
              boxShadow: "0 8px 24px rgba(16,24,40,.12)",
              padding: 6,
            }}
          >
            {(["all", ...REGION_ORDER] as (RegionKey | "all")[]).map((key) => {
              const isActive = activeRegion === key;
              const count = key === "all" ? Object.values(counts).reduce((a, b) => a + b, 0) : counts[key] ?? 0;
              const disabled = key !== "all" && count === 0;
              return (
                <button
                  key={key}
                  disabled={disabled}
                  className="msc-region-row"
                  onClick={() => {
                    onChange(key);
                    setOpen(false);
                  }}
                  style={{
                    display: "flex",
                    width: "100%",
                    alignItems: "center",
                    justifyContent: "space-between",
                    gap: 12,
                    border: "none",
                    background: isActive ? "#f4f6fb" : "transparent",
                    color: disabled ? "#cbd2dc" : isActive ? accent : "#475467",
                    borderRadius: 8,
                    padding: "9px 10px",
                    fontSize: 13,
                    fontWeight: isActive ? 700 : 500,
                    cursor: disabled ? "not-allowed" : "pointer",
                    textAlign: "left",
                  }}
                >
                  <span>{key === "all" ? t.allRegions : regionLabel(key as RegionKey, lang)}</span>
                  <span style={{ color: disabled ? "#dde3ee" : "#98a2b3", fontWeight: 500, fontSize: 12 }}>{count}</span>
                </button>
              );
            })}
          </div>
        </>
      )}
    </div>
  );
}

// ─── Category rail ───────────────────────────────────────────────────────────

function CategoryRail({
  categories,
  activeCategory,
  areaTotal,
  accent,
  lang,
  onSelect,
  className,
}: {
  categories: [string, number][];
  activeCategory: string;
  areaTotal: number;
  accent: string;
  lang: LangKey;
  onSelect: (cat: string) => void;
  className?: string;
}) {
  const t = UI[lang];
  const useFamilies = categories.length > 8;

  const railRow = (cat: string, count: number, selected: boolean) => (
    <button
      key={cat}
      className="msc-rail-row"
      onClick={() => onSelect(cat)}
      style={{
        display: "flex",
        width: "100%",
        alignItems: "center",
        justifyContent: "space-between",
        gap: 8,
        border: "none",
        borderLeft: selected ? `3px solid ${accent}` : "3px solid transparent",
        background: selected ? "#f4f6fb" : "transparent",
        color: selected ? accent : "#475467",
        fontWeight: selected ? 700 : 500,
        fontSize: 13,
        borderRadius: 8,
        padding: "8px 10px",
        cursor: "pointer",
        textAlign: "left",
        minHeight: 36,
      }}
    >
      <span style={{ overflow: "hidden", textOverflow: "ellipsis", whiteSpace: "nowrap" }}>{cat}</span>
      <span style={{ color: "#98a2b3", fontWeight: 500, fontSize: 12, flexShrink: 0 }}>{count}</span>
    </button>
  );

  return (
    <div className={`msc-rail msc-anim ${className ?? ""}`}>
      {railRow(`${t.allCats}`, areaTotal, activeCategory === "all")}
      {useFamilies
        ? FAMILY_ORDER.map((fam) => {
            const inFam = categories.filter(([c]) => familyOf(c) === fam);
            if (inFam.length === 0) return null;
            return (
              <div key={fam}>
                <div style={{ fontSize: 10, fontWeight: 700, color: "#98a2b3", textTransform: "uppercase", letterSpacing: ".05em", padding: "12px 10px 4px" }}>
                  {FAMILY_LABELS[fam][lang]}
                </div>
                {inFam.map(([cat, count]) => railRow(cat, count, activeCategory === cat))}
              </div>
            );
          })
        : categories.map(([cat, count]) => railRow(cat, count, activeCategory === cat))}
    </div>
  );
}

// ─── Product detail drawer ───────────────────────────────────────────────────

function TechField({ label, value, chips }: { label: string; value: ReactNode; chips?: string[] }) {
  return (
    <div style={{ display: "grid", gridTemplateColumns: "120px 1fr", gap: 12, padding: "8px 0", borderBottom: "1px solid #f1f3f5" }}>
      <div style={{ fontSize: 12, color: "#98a2b3" }}>{label}</div>
      {chips ? (
        <div style={{ display: "flex", flexWrap: "wrap", gap: 5 }}>
          {chips.map((c, i) => (
            <span key={i} style={{ background: "#f2f4f7", borderRadius: 6, padding: "2px 7px", fontSize: 11, color: "#475467" }}>
              {c}
            </span>
          ))}
        </div>
      ) : (
        <div style={{ fontSize: 13, color: "#101828", fontWeight: 500 }}>{value}</div>
      )}
    </div>
  );
}

function ProductDetailDrawer({
  winner,
  lang,
  onClose,
  onRegion,
  onSelectCategory,
}: {
  winner: Winner | null;
  lang: LangKey;
  onClose: () => void;
  onRegion: (key: RegionKey) => void;
  onSelectCategory: (session: SessionKey, cat: string) => void;
}) {
  const closeRef = useRef<HTMLButtonElement>(null);

  useEffect(() => {
    if (!winner) return;
    const onKey = (e: KeyboardEvent) => {
      if (e.key === "Escape") onClose();
    };
    window.addEventListener("keydown", onKey);
    document.body.style.overflow = "hidden";
    closeRef.current?.focus();
    return () => {
      window.removeEventListener("keydown", onKey);
      document.body.style.overflow = "";
    };
  }, [winner, onClose]);

  if (!winner) return null;
  const w = winner;
  const t = UI[lang];
  const L = (k: keyof typeof SHEET_LABELS) => SHEET_LABELS[k][lang];
  const rk = regionKeyOf(w);
  const mtImg = magnificaTastingImageFor(w);

  const fields: ReactNode[] = [];
  if (present(w.product_type)) fields.push(<TechField key="pt" label={L("product_type")} value={w.product_type} />);
  if (present(w.prefecture)) fields.push(<TechField key="pf" label={L("prefecture")} value={w.prefecture} />);
  fields.push(
    <TechField
      key="rg"
      label={L("region")}
      value={
        <span className="msc-link" onClick={() => { onRegion(rk); onClose(); }} style={{ cursor: "pointer", color: "#1e3a8a" }}>
          {regionLabel(rk, lang)}
        </span>
      }
    />
  );
  if (present(w.polishing_rate)) fields.push(<TechField key="pr" label={L("polishing_rate")} value={formatPct(w.polishing_rate!)} />);
  if (present(w.smv)) fields.push(<TechField key="smv" label={L("smv")} value={formatSmv(w.smv!)} />);
  if (present(w.alcohol)) fields.push(<TechField key="al" label={L("alcohol")} value={formatPct(w.alcohol!)} />);
  if (present(w.price)) fields.push(<TechField key="pc" label={L("price")} value={formatPrice(w.price!, w.currency)} />);
  if (present(w.rice)) fields.push(<TechField key="ri" label={L("rice")} value={asArray(w.rice).join(", ")} />);
  if (present(w.koji_rice)) fields.push(<TechField key="kr" label={L("koji_rice")} value={asArray(w.koji_rice).join(", ")} />);
  if (present(w.koji)) fields.push(<TechField key="kj" label={L("koji")} value={asArray(w.koji).join(", ")} />);
  if (present(w.yeast)) fields.push(<TechField key="ye" label={L("yeast")} value={asArray(w.yeast).join(", ")} />);
  if (present(w.aroma)) fields.push(<TechField key="ar" label={L("aroma")} value={null} chips={asArray(w.aroma)} />);
  if (present(w.taste)) fields.push(<TechField key="ta" label={L("taste")} value={asArray(w.taste).join(", ")} />);
  if (present(w.finishing)) fields.push(<TechField key="fi" label={L("finishing")} value={asArray(w.finishing).join(", ")} />);
  if (present(w.shochu_type)) fields.push(<TechField key="st" label={L("shochu_type")} value={w.shochu_type} />);
  if (present(w.distillation)) fields.push(<TechField key="di" label={L("distillation")} value={w.distillation} />);
  if (present(w.years_aging)) fields.push(<TechField key="ya" label={L("years_aging")} value={w.years_aging} />);
  if (present(w.bubble)) fields.push(<TechField key="bu" label={L("bubble")} value={w.bubble} />);
  if (present(w.brewery_founded)) fields.push(<TechField key="bf" label={L("brewery_founded")} value={w.brewery_founded} />);

  return (
    <div role="dialog" aria-modal="true" style={{ position: "fixed", inset: 0, zIndex: 100 }}>
      <div onClick={onClose} style={{ position: "absolute", inset: 0, background: "rgba(16,24,40,.45)" }} />
      <div
        className="msc-drawer-panel msc-anim"
        style={{
          position: "absolute",
          top: 0,
          right: 0,
          height: "100vh",
          width: "min(460px, 100%)",
          background: "#fff",
          borderLeft: "1px solid #e9ebef",
          boxShadow: "-8px 0 24px rgba(16,24,40,.12)",
          overflowY: "auto",
          padding: 24,
        }}
      >
        <div style={{ display: "flex", justifyContent: "space-between", alignItems: "flex-start", gap: 12 }}>
          <div style={{ display: "flex", alignItems: "center", gap: 10 }}>
            {hasMedalArt(w) && (
              <Image src={medalImageFor(w)} alt="" width={40} height={40} style={{ objectFit: "contain" }} />
            )}
            <MedalPill medal={w.medal} lang={lang} />
          </div>
          <button ref={closeRef} onClick={onClose} aria-label="Chiudi" style={{ border: "none", background: "#f2f4f7", borderRadius: 8, width: 32, height: 32, cursor: "pointer", fontSize: 15, color: "#475467" }}>
            ✕
          </button>
        </div>

        <div style={{ fontSize: 12, color: "#98a2b3", marginTop: 14 }}>
          {SESSION_META[w.session][lang]} · {w.category} · {regionLabel(rk, lang)}
        </div>
        <h2 style={{ fontSize: 20, fontWeight: 700, color: "#101828", margin: "4px 0 4px" }}>{w.name}</h2>
        <div style={{ fontSize: 14, color: "#475467" }}>{companyName(w, lang)}</div>

        {mtImg && (
          <div style={{ display: "flex", alignItems: "center", gap: 10, marginTop: 16, padding: "10px 12px", background: "#fdf1f5", border: "1px solid #f6d8e3", borderRadius: 12 }}>
            <Image src={mtImg} alt="" width={36} height={36} style={{ objectFit: "contain" }} />
            <div>
              <div style={{ fontSize: 13, fontWeight: 700, color: "#9d174d" }}>Magnifica · Tasting</div>
              <div style={{ fontSize: 11, color: "#be185d" }}>
                {lang === "ja" ? "テイスティング特別賞" : lang === "en" ? "Special tasting distinction" : "Menzione speciale di degustazione"}
              </div>
            </div>
          </div>
        )}

        <div style={{ marginTop: 22, marginBottom: 6 }}>
          <div style={{ fontSize: 11, fontWeight: 700, color: "#98a2b3", textTransform: "uppercase", letterSpacing: ".05em", borderBottom: "1px solid #eef0f3", paddingBottom: 6 }}>
            {t.techSheet}
          </div>
        </div>
        <div>{fields}</div>

        <div style={{ display: "flex", flexDirection: "column", gap: 10, marginTop: 20 }}>
          {present(w.brewery_website) && (
            <a
              href={w.brewery_website}
              target="_blank"
              rel="noopener noreferrer"
              style={{ display: "inline-block", textAlign: "center", border: "1px solid #d7dbe2", borderRadius: 9, padding: "9px 14px", fontSize: 13, fontWeight: 600, color: "#1e3a8a", textDecoration: "none" }}
            >
              {t.breweryWebsite} ↗
            </a>
          )}
          <button
            onClick={() => { onSelectCategory(w.session, w.category); onClose(); }}
            style={{ border: "none", background: "transparent", color: "#667085", fontSize: 12, fontWeight: 600, cursor: "pointer", padding: 4 }}
          >
            {t.otherInCat} →
          </button>
        </div>
        <div style={{ fontSize: 11, color: "#cbd2dc", marginTop: 16, textAlign: "center" }}>{t.noScore}</div>
      </div>
    </div>
  );
}

// ─── Responsive + interaction CSS ────────────────────────────────────────────

const CSS = `
.msc-card { transition: transform .12s ease, box-shadow .12s ease, border-color .12s ease; }
.msc-card:hover { transform: translateY(-2px); box-shadow: 0 6px 16px rgba(16,24,40,.08); border-color: #d7dbe2; }
.msc-row { transition: transform .12s ease, box-shadow .12s ease, border-color .12s ease; }
.msc-row:hover { transform: translateY(-1px); box-shadow: 0 6px 16px rgba(16,24,40,.08); border-color: #c7d0e8; }
.msc-rail-row:hover { background: #f2f4f7 !important; }
.msc-region-row:hover:not(:disabled) { background: #f2f4f7 !important; }
.msc-link:hover { text-decoration: underline; }
.msc-hub-areas { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
.msc-special-strip { display: flex; gap: 14px; flex-wrap: wrap; align-items: stretch; }
.msc-award-card { min-width: 0; }
.msc-ws-grid { display: grid; grid-template-columns: 240px 1fr; gap: 28px; align-items: start; }
.msc-ws-grid > * { min-width: 0; }
.msc-rail { position: sticky; top: 150px; display: flex; flex-direction: column; gap: 1px; }
.msc-rail-toggle { display: none; }
@media (max-width: 980px) { .msc-hub-areas { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 860px) {
  .msc-ws-grid { grid-template-columns: 1fr; gap: 12px; }
  .msc-rail { position: static; }
  .msc-rail-toggle { display: flex; }
  .msc-rail-collapsed { display: none; }
}
@media (max-width: 560px) { .msc-hub-areas { grid-template-columns: 1fr; } }
@media (max-width: 720px) {
  .msc-special-strip { flex-wrap: nowrap; overflow-x: auto; scroll-snap-type: x mandatory; -webkit-overflow-scrolling: touch; padding-bottom: 6px; }
  .msc-award-card { scroll-snap-align: start; }
}
@media (max-width: 720px) {
  .msc-drawer-panel { top: auto !important; bottom: 0; right: 0; left: 0; height: 92vh !important; width: 100% !important; border-left: none !important; border-top-left-radius: 16px; border-top-right-radius: 16px; }
}
@media (prefers-reduced-motion: reduce) {
  .msc-anim, .msc-card, .msc-row { transition: none !important; }
  .msc-card:hover, .msc-row:hover { transform: none !important; }
}
`;

// ─── Main component ──────────────────────────────────────────────────────────

export function MedagliereClient() {
  const [lang, setLang] = useState<LangKey>("it");
  const [activeSession, setActiveSession] = useState<SessionKey | null>(null);
  const [activeCategory, setActiveCategory] = useState<string>("all");
  const [activeRegion, setActiveRegion] = useState<RegionKey | "all">("all");
  const [medalFilter, setMedalFilter] = useState<MedalKey | null>(null);
  const [searchQ, setSearchQ] = useState("");
  const [openProductId, setOpenProductId] = useState<string | null>(null);
  const [railOpen, setRailOpen] = useState(false);
  const hashHydrated = useRef(false);

  const t = UI[lang];

  // Deep-link: parse hash on mount
  useEffect(() => {
    const h = decodeURIComponent(window.location.hash.replace(/^#/, ""));
    if (!h) return;
    if (h.startsWith("p/")) {
      const id = h.slice(2);
      const w = winners.find((x) => x.reg_id === id);
      if (w) {
        setActiveSession(w.session);
        setOpenProductId(id);
      }
      return;
    }
    const [sess, cat] = h.split("/");
    if ((SESSION_ORDER as string[]).includes(sess)) {
      setActiveSession(sess as SessionKey);
      if (cat) setActiveCategory(cat);
    }
  }, []);

  // Write a shareable hash when the view-defining state changes.
  // Skip the very first run so the mount-time parse (above) isn't clobbered
  // by an empty initial-state hash before its setState lands.
  useEffect(() => {
    if (!hashHydrated.current) {
      hashHydrated.current = true;
      return;
    }
    let hash = "";
    if (openProductId) hash = `#p/${openProductId}`;
    else if (activeSession) hash = activeCategory !== "all" ? `#${activeSession}/${encodeURIComponent(activeCategory)}` : `#${activeSession}`;
    if (`#${decodeURIComponent(window.location.hash.replace(/^#/, ""))}` !== hash) {
      window.history.replaceState(null, "", hash || window.location.pathname);
    }
  }, [activeSession, activeCategory, openProductId]);

  // Global medal tally (unfiltered)
  const globalTally = useMemo(() => {
    const c: Partial<Record<MedalKey, number>> = {};
    for (const w of winners) c[w.medal] = (c[w.medal] ?? 0) + 1;
    return c;
  }, []);

  const sessionCounts = useMemo(() => {
    const c: Record<string, number> = {};
    for (const w of winners) c[w.session] = (c[w.session] ?? 0) + 1;
    return c;
  }, []);

  const sessionCatCounts = useMemo(() => {
    const c: Record<string, Set<string>> = {};
    for (const w of winners) {
      (c[w.session] ??= new Set()).add(w.category);
    }
    const out: Record<string, number> = {};
    for (const k in c) out[k] = c[k].size;
    return out;
  }, []);

  const magnificaWinners = useMemo(
    () => winners.filter((w) => w.medal === "magnifica").sort((a, b) => a.category.localeCompare(b.category)),
    []
  );

  // Base set for the active session
  const sessionSet = useMemo(
    () => (activeSession ? winners.filter((w) => w.session === activeSession) : []),
    [activeSession]
  );

  const matchesSearch = (w: Winner, needle: string) =>
    !needle || `${w.name} ${w.company_en} ${w.company_jp}`.toLowerCase().includes(needle);

  // Category counts (respect region + medal + search, NOT category)
  const categories = useMemo(() => {
    const needle = searchQ.trim().toLowerCase();
    const m = new Map<string, number>();
    for (const w of sessionSet) {
      if (activeRegion !== "all" && regionKeyOf(w) !== activeRegion) continue;
      if (medalFilter && w.medal !== medalFilter) continue;
      if (!matchesSearch(w, needle)) continue;
      m.set(w.category, (m.get(w.category) ?? 0) + 1);
    }
    return Array.from(m.entries()).sort((a, b) => a[0].localeCompare(b[0]));
  }, [sessionSet, activeRegion, medalFilter, searchQ]);

  const areaTotal = useMemo(() => categories.reduce((s, [, n]) => s + n, 0), [categories]);

  // Region counts (respect category + medal + search, NOT region)
  const regionCounts = useMemo(() => {
    const needle = searchQ.trim().toLowerCase();
    const c: Record<string, number> = {};
    for (const w of sessionSet) {
      if (activeCategory !== "all" && w.category !== activeCategory) continue;
      if (medalFilter && w.medal !== medalFilter) continue;
      if (!matchesSearch(w, needle)) continue;
      const k = regionKeyOf(w);
      c[k] = (c[k] ?? 0) + 1;
    }
    return c;
  }, [sessionSet, activeCategory, medalFilter, searchQ]);

  // Final filtered list
  const filtered = useMemo(() => {
    const needle = searchQ.trim().toLowerCase();
    return sessionSet.filter((w) => {
      if (activeCategory !== "all" && w.category !== activeCategory) return false;
      if (activeRegion !== "all" && regionKeyOf(w) !== activeRegion) return false;
      if (medalFilter && w.medal !== medalFilter) return false;
      if (!matchesSearch(w, needle)) return false;
      return true;
    });
  }, [sessionSet, activeCategory, activeRegion, medalFilter, searchQ]);

  // Group: category → medal → alphabetical rows
  const grouped = useMemo(() => {
    const byCat = new Map<string, Map<MedalKey, Winner[]>>();
    for (const w of filtered) {
      if (!byCat.has(w.category)) byCat.set(w.category, new Map());
      const bm = byCat.get(w.category)!;
      if (!bm.has(w.medal)) bm.set(w.medal, []);
      bm.get(w.medal)!.push(w);
    }
    return Array.from(byCat.entries()).sort((a, b) => a[0].localeCompare(b[0]));
  }, [filtered]);

  const openWinner = useMemo(
    () => (openProductId ? winners.find((w) => w.reg_id === openProductId) ?? null : null),
    [openProductId]
  );

  // ── Actions ──
  function enterArea(s: SessionKey, medal: MedalKey | null = null) {
    setActiveSession(s);
    setActiveCategory("all");
    setActiveRegion("all");
    setSearchQ("");
    setMedalFilter(medal);
  }
  function goHub() {
    setActiveSession(null);
    setActiveCategory("all");
    setActiveRegion("all");
    setSearchQ("");
    setMedalFilter(null);
  }
  function pickRegion(key: RegionKey) {
    if (!activeSession) return;
    setActiveRegion(key);
  }

  const chips: { label: string; clear: () => void }[] = [];
  if (activeCategory !== "all") chips.push({ label: activeCategory, clear: () => setActiveCategory("all") });
  if (activeRegion !== "all") chips.push({ label: regionLabel(activeRegion as RegionKey, lang), clear: () => setActiveRegion("all") });
  if (medalFilter) chips.push({ label: medalLabel(medalFilter, lang), clear: () => setMedalFilter(null) });
  if (searchQ.trim()) chips.push({ label: `"${searchQ.trim()}"`, clear: () => setSearchQ("") });

  const accent = activeSession ? SESSION_META[activeSession].accent : "#1e3a8a";

  // ── Styles ──
  const contentStyle: CSSProperties = { maxWidth: 1280, margin: "0 auto", padding: "0 28px" };

  return (
    <div style={{ minHeight: "100vh", background: "#f5f6f8", fontFamily: "'Inter', 'Hiragino Kaku Gothic ProN', 'Noto Sans JP', sans-serif" }}>
      <style>{CSS}</style>

      {/* Header */}
      <header style={{ position: "sticky", top: 0, zIndex: 40, height: 60, background: "#fff", borderBottom: "1px solid #e8eaed", display: "flex", alignItems: "center" }}>
        <div style={{ ...contentStyle, width: "100%", display: "flex", alignItems: "center", justifyContent: "space-between" }}>
          <button onClick={goHub} style={{ display: "flex", alignItems: "center", gap: 10, border: "none", background: "transparent", cursor: "pointer", padding: 0 }}>
            <div style={{ width: 32, height: 32, borderRadius: 8, background: "#1e3a8a", display: "flex", alignItems: "center", justifyContent: "center", color: "#fff", fontWeight: 700, fontSize: 15 }}>M</div>
            <div style={{ textAlign: "left" }}>
              <div style={{ fontWeight: 700, fontSize: 15, color: "#1e3a8a", lineHeight: 1.2 }}>MSC 2026</div>
              <div style={{ fontSize: 11, color: "#98a2b3", fontWeight: 500 }}>{t.portal}</div>
            </div>
          </button>
          <div style={{ display: "flex", background: "#f2f4f7", borderRadius: 9, padding: 2, gap: 1 }}>
            {(["it", "en", "ja"] as LangKey[]).map((l) => (
              <button key={l} onClick={() => setLang(l)} style={{ padding: "4px 10px", borderRadius: 7, border: "none", cursor: "pointer", fontSize: 12, fontWeight: 600, background: lang === l ? "#1e3a8a" : "transparent", color: lang === l ? "#fff" : "#667085" }}>
                {l === "ja" ? "日本語" : l.toUpperCase()}
              </button>
            ))}
          </div>
        </div>
      </header>

      {!activeSession ? (
        /* ═══ HUB ═══ */
        <div style={contentStyle}>
          <div style={{ paddingTop: 34, paddingBottom: 24 }}>
            <div style={{ fontSize: 11, fontWeight: 600, color: "#1e3a8a", letterSpacing: ".08em", textTransform: "uppercase", marginBottom: 8 }}>
              {t.kicker} · {t.alboSuffix}
            </div>
            <h1 style={{ fontSize: 32, fontWeight: 700, color: "#101828", margin: "0 0 8px", letterSpacing: "-0.01em" }}>{t.title}</h1>
            <p style={{ fontSize: 14, color: "#667085", lineHeight: 1.7, margin: "0 0 20px", maxWidth: 600 }}>{t.subtitle}</p>

            <div style={{ display: "flex", flexWrap: "wrap", gap: "10px 24px", borderTop: "1px solid #eef0f3", paddingTop: 16 }}>
              {(["platinum", "double_gold", "gold", "silver"] as MedalKey[]).map((mk) => (
                <div key={mk} style={{ display: "flex", alignItems: "center", gap: 7 }}>
                  <span style={{ width: 10, height: 10, borderRadius: "50%", background: MEDAL_META[mk].dot }} />
                  <span style={{ fontSize: 18, fontWeight: 700, color: "#101828", lineHeight: 1 }}>{globalTally[mk] ?? 0}</span>
                  <span style={{ fontSize: 11, fontWeight: 600, color: "#8a93a3" }}>{MEDAL_META[mk][lang]}</span>
                </div>
              ))}
              <div style={{ display: "flex", alignItems: "center", gap: 7 }}>
                <span style={{ width: 10, height: 10, borderRadius: "50%", background: "#1e3a8a" }} />
                <span style={{ fontSize: 18, fontWeight: 700, color: "#101828", lineHeight: 1 }}>{winners.length}</span>
                <span style={{ fontSize: 11, fontWeight: 600, color: "#8a93a3" }}>{t.totalMedals}</span>
              </div>
            </div>
          </div>

          <SpecialAwardsStrip
            lang={lang}
            platinumCount={globalTally.platinum ?? 0}
            bestDesignCount={globalTally.best_design ?? 0}
            magnifica={magnificaWinners}
            onEnterArea={enterArea}
            onOpenProduct={(id) => setOpenProductId(id)}
          />

          <SectionLabel>{t.esploraAree}</SectionLabel>
          <div className="msc-hub-areas">
            {SESSION_ORDER.map((s) => (
              <MacroAreaCard
                key={s}
                session={s}
                count={sessionCounts[s] ?? 0}
                catCount={sessionCatCounts[s] ?? 0}
                catUnit={s === "pairing" ? t.cibi : t.categorie}
                lang={lang}
                onSelect={() => enterArea(s)}
              />
            ))}
          </div>
          <div style={{ textAlign: "center", fontSize: 12, color: "#98a2b3", margin: "20px 0 48px" }}>{t.closingLine}</div>
        </div>
      ) : (
        /* ═══ WORKSPACE ═══ */
        <div style={contentStyle}>
          {/* Sticky sub-bar */}
          <div style={{ position: "sticky", top: 60, zIndex: 30, background: "#f5f6f8", paddingTop: 8, paddingBottom: 12 }}>
            <div style={{ background: "#fff", border: "1px solid #e9ebef", borderRadius: 14, padding: "12px 16px", boxShadow: "0 4px 14px rgba(16,24,40,.06)" }}>
              {/* breadcrumb + area switcher */}
              <div style={{ display: "flex", alignItems: "center", justifyContent: "space-between", flexWrap: "wrap", gap: 10 }}>
                <div style={{ fontSize: 13, color: "#667085", display: "flex", alignItems: "center", gap: 6, flexWrap: "wrap" }}>
                  <span className="msc-link" onClick={goHub} style={{ cursor: "pointer" }}>{t.hallRoot}</span>
                  <span style={{ color: "#cbd2dc" }}>/</span>
                  <span className="msc-link" onClick={() => { setActiveCategory("all"); setMedalFilter(null); }} style={{ cursor: "pointer", color: activeCategory === "all" ? "#101828" : "#667085", fontWeight: activeCategory === "all" ? 600 : 400 }}>
                    {SESSION_META[activeSession][lang]}
                  </span>
                  {activeCategory !== "all" && (
                    <>
                      <span style={{ color: "#cbd2dc" }}>/</span>
                      <span style={{ color: "#101828", fontWeight: 600 }}>{activeCategory}</span>
                    </>
                  )}
                </div>
                <div style={{ display: "flex", background: "#f2f4f7", borderRadius: 9, padding: 2, gap: 1 }}>
                  {SESSION_ORDER.map((s) => (
                    <button key={s} onClick={() => enterArea(s)} style={{ padding: "5px 11px", borderRadius: 7, border: "none", cursor: "pointer", fontSize: 12, fontWeight: 600, background: activeSession === s ? SESSION_META[s].accent : "transparent", color: activeSession === s ? "#fff" : "#667085" }}>
                      {SESSION_META[s].short[lang]}
                    </button>
                  ))}
                </div>
              </div>

              {/* toolbar */}
              <div style={{ display: "flex", alignItems: "center", gap: 10, flexWrap: "wrap", marginTop: 12, paddingTop: 12, borderTop: "1px solid #f1f3f5" }}>
                <RegionFilter activeRegion={activeRegion} counts={regionCounts} accent={accent} lang={lang} onChange={(k) => setActiveRegion(k)} />
                <div style={{ position: "relative", flex: 1, minWidth: 180 }}>
                  <span style={{ position: "absolute", left: 12, top: "50%", transform: "translateY(-50%)", color: "#98a2b3", fontSize: 14, pointerEvents: "none" }}>⌕</span>
                  <input
                    type="text"
                    value={searchQ}
                    onChange={(e) => setSearchQ(e.target.value)}
                    placeholder={`${t.searchPh} ${SESSION_META[activeSession].short[lang]}…`}
                    style={{ width: "100%", padding: "8px 12px 8px 34px", borderRadius: 9, border: "1px solid #d7dbe2", fontSize: 13, color: "#101828", background: "#fff", outline: "none", boxSizing: "border-box" }}
                  />
                </div>
              </div>

              {/* chips */}
              {chips.length > 0 && (
                <div style={{ display: "flex", alignItems: "center", gap: 8, flexWrap: "wrap", marginTop: 10 }}>
                  {chips.map((c, i) => (
                    <FilterChip key={i} label={c.label} onRemove={c.clear} />
                  ))}
                  <button onClick={() => { setActiveCategory("all"); setActiveRegion("all"); setMedalFilter(null); setSearchQ(""); }} style={{ border: "none", background: "transparent", color: "#667085", fontSize: 12, fontWeight: 600, cursor: "pointer" }}>
                    {t.clearAll}
                  </button>
                </div>
              )}
            </div>
          </div>

          {/* two-column body */}
          <div className="msc-ws-grid" style={{ paddingBottom: 60 }}>
            <div>
              <button
                className="msc-rail-toggle"
                onClick={() => setRailOpen((o) => !o)}
                style={{ width: "100%", alignItems: "center", justifyContent: "space-between", border: "1px solid #d7dbe2", background: "#fff", borderRadius: 9, padding: "10px 14px", fontSize: 13, fontWeight: 600, color: "#475467", cursor: "pointer", marginBottom: 8 }}
              >
                <span>{t.categorie}: {activeCategory === "all" ? t.allCats : activeCategory}</span>
                <span style={{ fontSize: 11, opacity: 0.7 }}>{railOpen ? "▴" : "▾"}</span>
              </button>
              <CategoryRail
                categories={categories}
                activeCategory={activeCategory}
                areaTotal={areaTotal}
                accent={accent}
                lang={lang}
                className={railOpen ? "" : "msc-rail-collapsed"}
                onSelect={(c) => {
                  setActiveCategory(c);
                  setRailOpen(false);
                }}
              />
            </div>

            <div>
              <div style={{ marginBottom: 16, fontSize: 14, color: "#475467", display: "flex", alignItems: "center", gap: 6 }}>
                <span style={{ fontWeight: 700, color: accent, fontSize: 15 }}>{filtered.length}</span>
                <span>{t.winnerCount} · {t.alphaOrder}</span>
              </div>

              {filtered.length === 0 ? (
                <div style={{ background: "#fff", border: "1px solid #e9ebef", borderRadius: 14, padding: "48px 28px", textAlign: "center" }}>
                  <div style={{ fontSize: 24, marginBottom: 8 }}>⌕</div>
                  <div style={{ fontSize: 15, fontWeight: 600, color: "#475467", marginBottom: 6 }}>{t.noResults}</div>
                  <div style={{ fontSize: 13, color: "#98a2b3" }}>{t.noResultsSub}</div>
                </div>
              ) : (
                grouped.map(([category, medalMap]) => (
                  <div key={category} style={{ marginBottom: 30 }}>
                    <div style={{ display: "flex", alignItems: "center", gap: 10, marginBottom: 12 }}>
                      <span style={{ width: 7, height: 7, borderRadius: "50%", background: accent }} />
                      <span style={{ fontSize: 12, fontWeight: 700, color: "#475467", textTransform: "uppercase", letterSpacing: ".05em" }}>{category}</span>
                      <div style={{ flex: 1, height: 1, background: "#e7eaef" }} />
                      <span style={{ fontSize: 11, color: "#98a2b3", fontWeight: 500 }}>
                        {Array.from(medalMap.values()).reduce((s, a) => s + a.length, 0)}
                      </span>
                    </div>

                    {Array.from(medalMap.entries())
                      .sort(([a], [b]) => MEDAL_RANK[a as MedalKey] - MEDAL_RANK[b as MedalKey])
                      .map(([medal, rows]) => (
                        <div key={medal} style={{ marginBottom: 14 }}>
                          <div style={{ display: "flex", alignItems: "center", gap: 8, marginBottom: 8, paddingLeft: 4 }}>
                            <MedalPill medal={medal as MedalKey} lang={lang} />
                            <span style={{ fontSize: 12, color: "#98a2b3", fontWeight: 500 }}>{rows.length}</span>
                          </div>
                          <div style={{ display: "flex", flexDirection: "column", gap: 8 }}>
                            {rows
                              .slice()
                              .sort((a, b) => a.name.localeCompare(b.name))
                              .map((w) => (
                                <ProductRow
                                  key={w.reg_id}
                                  winner={w}
                                  lang={lang}
                                  showCategory={activeCategory === "all" && grouped.length > 1}
                                  onOpen={(id) => setOpenProductId(id)}
                                  onRegion={pickRegion}
                                />
                              ))}
                          </div>
                        </div>
                      ))}
                  </div>
                ))
              )}
            </div>
          </div>
        </div>
      )}

      {/* Footer */}
      <footer style={{ background: "#fff", borderTop: "1px solid #e8eaed", padding: "20px 28px" }}>
        <div style={{ maxWidth: 1280, margin: "0 auto", display: "flex", alignItems: "center", justifyContent: "space-between", flexWrap: "wrap", gap: 8 }}>
          <div style={{ display: "flex", alignItems: "center", gap: 8 }}>
            <div style={{ width: 22, height: 22, borderRadius: 5, background: "#1e3a8a", display: "flex", alignItems: "center", justifyContent: "center", color: "#fff", fontWeight: 700, fontSize: 10 }}>M</div>
            <span style={{ fontSize: 12, color: "#98a2b3" }}>Milano Sake Challenge 2026 · Sake Sommelier Association</span>
          </div>
          <span style={{ fontSize: 11, color: "#cbd2dc" }}>{t.responsibly}</span>
        </div>
      </footer>

      {/* Product detail drawer */}
      <ProductDetailDrawer
        winner={openWinner}
        lang={lang}
        onClose={() => setOpenProductId(null)}
        onRegion={pickRegion}
        onSelectCategory={(s, cat) => { setActiveSession(s); setActiveCategory(cat); }}
      />
    </div>
  );
}
