const MEDAL_PLACEHOLDER = "/medals/placeholder.png";

// Tasting tier → filename stem (nihonshu/shochu share the scheme)
const TASTING_TIER: Record<string, string> = {
  platinum: "platino",
  double_gold: "doppio_oro",
  gold: "oro",
  silver: "argento",
};
// Category codes that actually have artwork on disk (the rest fall back to the placeholder)
const BEST_DESIGN_CODES = new Set(["D", "F", "G", "GG", "H", "J", "JDO", "JDU", "K", "N", "S", "U", "Y", "AG", "AW", "BA", "RI", "SP", "SSH"]);
const PAIRING_ART_CODES = new Set(["PR", "SD", "TA"]);
const MT_CODES_NIHONSHU = new Set(["D", "F", "G", "GG", "H", "J", "JDO", "JDU", "K", "N", "S", "U", "Y"]);
const MT_CODES_SHOCHU = new Set(["AG", "AW", "BA", "RI", "SP", "SSH"]);

