  gold: { it: "Oro", en: "Gold", ja: "ゴールド賞", pillBg: "#fbf2da", pillText: "#92670f", dot: "#d2a02b" },
  silver: { it: "Argento", en: "Silver", ja: "シルバー賞", pillBg: "#eef1f4", pillText: "#5b6573", dot: "#9aa3ad" },
