interface SessionMeta {
  it: string;
  en: string;
  ja: string;
  jaName: string;
  short: Record<LangKey, string>;
  accent: string;
  wash: string;
}

const SESSION_META: Record<SessionKey, SessionMeta> = {
  nihonshu: { it: "Nihonshu", en: "Nihonshu", ja: "日本酒テイスティング", jaName: "日本酒", short: { it: "Nihonshu", en: "Nihonshu", ja: "日本酒" }, accent: "#1e3a8a", wash: "#eef1fb" },
  shochu: { it: "Shochu", en: "Shochu", ja: "焼酎テイスティング", jaName: "焼酎", short: { it: "Shochu", en: "Shochu", ja: "焼酎" }, accent: "#c2740c", wash: "#fdf3e6" },
  pairing: { it: "Abbinamento Cibo", en: "Food Pairing", ja: "フードペアリング", jaName: "フードペアリング", short: { it: "Pairing", en: "Pairing", ja: "ペアリング" }, accent: "#15803d", wash: "#effdf4" },
  design: { it: "Design", en: "Design", ja: "デザイン", jaName: "デザイン", short: { it: "Design", en: "Design", ja: "デザイン" }, accent: "#4f6fc7", wash: "#eef3ff" },
};

const SESSION_ORDER: SessionKey[] = ["nihonshu", "shochu", "pairing", "design"];

// medal tiers present in each session, in rank order
const SESSION_MEDALS: Record<SessionKey, MedalKey[]> = {
  nihonshu: ["platinum", "double_gold", "gold", "silver"],
  shochu: ["platinum", "double_gold", "gold", "silver"],
  pairing: ["magnifica", "good_with"],
  design: ["best_design", "good_design"],
};

// ─── Region config ───────────────────────────────────────────────────────────

const REGION_KEYS: RegionKey[] = ["hokkaido_tohoku", "kanto", "chubu_hokuriku", "kinki", "chugoku_shikoku", "kyushu_okinawa"];
const REGION_ORDER: RegionKey[] = [...REGION_KEYS, "altro"];

const REGION_META: Record<RegionKey, Record<LangKey, string>> = {
  hokkaido_tohoku: { it: "Hokkaido e Tohoku", en: "Hokkaido & Tohoku", ja: "北海道・東北" },
  kanto: { it: "Kanto", en: "Kanto", ja: "関東" },
  chubu_hokuriku: { it: "Chubu e Hokuriku", en: "Chubu & Hokuriku", ja: "中部・北陸" },
  kinki: { it: "Kinki", en: "Kinki", ja: "近畿" },
  chugoku_shikoku: { it: "Chugoku e Shikoku", en: "Chugoku & Shikoku", ja: "中国・四国" },
  kyushu_okinawa: { it: "Kyushu e Okinawa", en: "Kyushu & Okinawa", ja: "九州・沖縄" },
  altro: { it: "Altro / Estero", en: "Other / Foreign", ja: "その他・海外" },
};

function regionKeyOf(w: Winner): RegionKey {
  return w.region && (REGION_KEYS as string[]).includes(w.region) ? (w.region as RegionKey) : "altro";
}

// ─── Category families (rail dividers) ───────────────────────────────────────

type FamilyKey = "junmai" | "ginjo" | "altri";
const FAMILY_ORDER: FamilyKey[] = ["junmai", "ginjo", "altri"];
const FAMILY_LABELS: Record<FamilyKey, Record<LangKey, string>> = {
  junmai: { it: "Famiglia Junmai", en: "Junmai family", ja: "純米系" },
  ginjo: { it: "Ginjo / Honjozo", en: "Ginjo / Honjozo", ja: "吟醸・本醸造系" },
  altri: { it: "Altri stili", en: "Other styles", ja: "その他" },
};
function familyOf(cat: string): FamilyKey {
  if (/junmai/i.test(cat)) return "junmai";
  if (/daiginjo|ginjo|honjozo|futsushu/i.test(cat)) return "ginjo";
  return "altri";
}

