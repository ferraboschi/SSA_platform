\":[\"producer\"],\"allowPrivacy\":true,\"allowPromotions\":true,\"createdAt\":\"2025-01-14T10:12:44.849Z\",\"updatedAt\":\"2025-12-16T01:52:47.390Z\",\"__v\":0},\"product\":{\"_id\":\"6940bf4e1152ae3e88d3dff2\",\"user\":\"6786389c07e0e1ef295fb1e3\",\"company\":{\"address\":{\"country\":\"JP\",\"street\":\"山口県\",\"number\":\"1-1-31\",\"city\":\"中津町\",\"state\":\"岩国市\",\"zip\":\"7400027\",\"state_eng\":\"Yamaguchi\",\"state_original\":\"山口県\"},\"made_by\":\"producer\",\"_id\":\"678ae7d828711d8ba6073f44\",\"user\":\"6786389c07e0e1ef295fb1e3\",\"eng_name\":\"Sakaishuzo Co., Ltd.\",\"original_name\":\"酒井酒造株式会社\",\"phone\":\"+81827212177\",\"phone_country_code\":\"+81\",\"fax\":\"827215372\",\"fax_country_code\":\"+81\",\"website\":\"https://gokyo-sake.co.jp/\",\"description\":\"明治4年（1871年）錦川の伏流軟水に恵まれた岩国の地に蔵を構えました。五橋の名は錦川にかかる五連の反り橋「錦帯橋」に由来しており、錦帯橋の優美さを願い「心と心の架け橋に」との思いを込めて命名されました。\\n五橋の名が全国的に広まったのは、1947年春のこと。硬水仕込みが全盛の当時にあって軟水仕込による全国新酒鑑評会第１位の獲得は関係者の注目を集めるところとなりました。以来、杜氏の研ぎ澄まされた感覚とたゆまぬ努力、技術の研鑽により山口県下はもちろん、全国の多くのお客様のご支持をいただいています。五橋は軟水仕込み特有のソフトで香り高い酒質を特徴としています。\",\"contacts\":[{\"name\":\"優一 片山\",\"role\":\"Other\",\"phone\":\"827212177\",\"email\":\"yuuichi_katayama@gokyo-sake.co.jp\",\"_id\":\"678ae7d828711d8ba6073f45\"}],\"social\":[{\"name\":\"Instagram\",\"link\":\"https://www.instagram.com/sakaishuzo/\",\"_id\":\"6940bdd21152ae3e88d38d76\"},{\"name\":\"Facebook\",\"link\":\"https://www.facebook.com/sakaishuzo/?locale=ja_JP\",\"_id\":\"6940bdd21152ae3e88d38d77\"},{\"name\":\"X\",\"link\":\"https://x.com/sakaishuzo\",\"_id\":\"6940bdd21152ae3e88d38d78\"}],\"brands\":[\"678ae7d828711d8ba6073f48\"],\"createdAt\":\"2025-01-17T23:29:28.834Z\",\"updatedAt\":\"2025-12-16T02:02:58.801Z\",\"__v\":0,\"slug\":\"sakaishuzo-co-ltd\",\"foundation_year\":1871},\"type\":\"Sake\",\"eng_name\":\"Five Green Junmai Namagenshu Origarami\",\"slug\":\"five-green-junmai-namagenshu-origarami\",\"force\":0,\"images\":[\"https://storage.googleapis.com/compify-bucket-prod/SAKE/products/6940bf4e1152