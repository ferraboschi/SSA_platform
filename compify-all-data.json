す。\",\"contacts\":[{\"name\":\"Kenkichi Hongo\",\"role\":\"Sales\",\"phone\":\"223456886\",\"phone_country_code\":\"+81\",\"email\":\"hongo-k@yamaya.co.jp\",\"_id\":\"6792cd317ca904179fda4825\"},{\"name\":\"\",\"role\":\"Sales\",\"phone\":\"\",\"email\":\"\",\"_id\":\"6792cd317ca904179fda4826\"}],\"social\":[],\"brands\":[\"6792cd317ca904179fda4828\"],\"createdAt\":\"2025-01-23T23:13:53.598Z\",\"updatedAt\":\"2025-01-23T23:13:53.598Z\",\"__v\":0,\"slug\":\"taiwagura-sake-brewery\"},\"type\":\"Sake\",\"eng_name\":\"Yuki no Matsushima kai Winter Junmaidaiginjo Genshu\",\"slug\":\"yuki-no-matsushima-kai-winter-junmaidaiginjo-genshu\",\"force\":0,\"images\":[\"https://storage.googleapis.com/compify-bucket-prod/SAKE/products/696eec8af47886b172ba40d7/images/1768877195956_t3zf5q7t5tm_IMG_1777.JPG\"],\"imageThumbnails\":[\"https://storage.googleapis.com/compify-bucket-prod/SAKE/products/696eec8af47886b172ba40d7/images/1768877195956_t3zf5q7t5tm_IMG_1777-s.JPG\"],\"made_by\":\"producer\",\"createdAt\":\"2026-01-20T02:46:34.042Z\",\"updatedAt\":\"2026-01-20T02:46:36.099Z\",\"__v\":0,\"sake\":{\"_id\":\"696eec8af47886b172ba40d9\",\"user\":\"6786e3e0ea5cbc2ecc3968d6\",\"product\":\"696eec8af47886b172ba40d7\",\"awards\":[],\"eng_name\":\"Yuki no Matsushima kai Winter Junmaidaiginjo Genshu\",\"original_name\":\"雪の松島 KAI 冬 純米大吟醸 原酒\",\"finishing\":[],\"logistical_info\":[],\"aroma_profile\":[],\"taste_profile\":[],\"food_pairing\":[],\"sake_kakemai\":[],\"sake_kobo\":[],\"sake_kojimai\":[],\"sake_type\":[],\"sake_first_ingredient\":[],\"sake_second_ingredient\":[],\"sake_third_ingredient\":[],\"sake_other_ingredient\":[],\"labels\":[],\"createdAt\":\"2026-01-20T02:46:34.055Z\",\"updatedAt\":\"2026-01-20T02:46:34.055Z\",\"__v\":0}},\"company\":{\"address\":{\"country\":\"JP\",\"street\":\"松坂平\",\"number\":\"８－１\",\"city\":\"黒川郡大和町\",\"state\":\"宮城県\",\"zip\":\"9813408\",\"state_eng\":\"Miyagi\",\"state_original\":\"宮城県\"},\"made_by\":\"producer\",\"_id\":\"6792cd317ca904179fda4824\"