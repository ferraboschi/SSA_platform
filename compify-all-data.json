"registeredFromPayment\":true,\"firstPresenceActivated\":true,\"active\":true,\"onboarded\":true,\"type\":\"user\",\"photo\":null,\"roles\":[\"producer\"],\"allowPrivacy\":true,\"allowPromotions\":true,\"createdAt\":\"2025-01-14T22:23:28.815Z\",\"updatedAt\":\"2026-01-15T02:08:19.743Z\",\"__v\":0},\"product\":{\"imageThumbnails\":[],\"made_by\":\"producer\",\"_id\":\"6796c3fe7cbf845e4e85ac58\",\"user\":\"6786e3e0ea5cbc2ecc3968d6\",\"company\":{\"address\":{\"country\":\"JP\",\"street\":\"松坂平\",\"number\":\"８－１\",\"city\":\"黒川郡大和町\",\"state\":\"宮城県\",\"zip\":\"9813408\",\"state_eng\":\"Miyagi\",\"state_original\":\"宮城県\"},\"made_by\":\"producer\",\"_id\":\"6792cd317ca904179fda4824\",\"user\":\"6786e3e0ea5cbc2ecc3968d6\",\"eng_name\":\"Taiwagura Sake Brewery\",\"original_name\":\"大和蔵酒造株式会社\",\"phone\":\"223456886\",\"phone_country_code\":\"+81\",\"fax\":\"223456881\",\"fax_country_code\":\"+81\",\"website\":\"https://taiwagura.co.jp/\",\"description\":\"宮城は全国有数の米どころ。その宮城県のほぼ中央、船形山系の清冽な水に恵まれたこの地「黒川郡大和町」に酒造を構えて約30年。大和蔵酒造では純米酒や吟醸酒など、30種類以上の日本酒を作り続けています。より良い日本酒を、より多くの方にお届けしたい。その思いを具現化するために、酒蔵としては東北でも屈指の近代的な設備を整えています。\\nしかし、酒造りの根本を支えているのは、実際に仕込みを行う蔵人の経験や知識、そして勘です。最新のテクノロジーの力を借りながら、伝統の酒造りの技も継承する。その思いも忘れず、先進と伝統の技術を融合しながら、大和蔵酒造は皆さまに喜ばれる日本酒を追い求めてまいります。\",\"contacts\":[{\"name\":\"Kenkichi Hongo\",\"role\":\"Sales\",\"phone\":\"223456886\",\"phone_country_code\":\"+81\",\"email\":\"hongo-k@yamaya.co.jp\",\"_id\":\"6792cd317ca904179fda4825\"},{\"name\":\"\",\"role\":\"Sales\",\"phone\":\"\",\"email\":\"\",\"_id\":\"6792cd317ca904179fda4826\"}],\"social\":[],\"brands\":[\"6792cd317ca904179fda4828\"],\"createdAt\":\"2025-01-23T23:13:53.598Z\",\"updatedAt\":\"2025-01-23T23:13:53.598Z\",\"__v\":0,\"slug\":\"taiwagura-sake-brewery\"},\"brand\":\"6792cd317ca904179fda4828\",\"type\":\"Sake\",\"eng_name\":\"Yuki no Matsushima kai Junmaidaiginjo Genshu\",\"force\":0,\"sake\":{\"_id\":\"6796c3fe7cbf845e4e85ac5a\",\"user\":\"6786e3e0ea5cbc2ecc3968d6\",\"product\":\"6796c3fe7cbf845e4e85ac58