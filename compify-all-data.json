_by\":\"producer\",\"_id\":\"6796e78f7cbf845e4e85bc35\",\"user\":\"6786e3ecea5cbc2ecc39694f\",\"eng_name\":\"NIIZAWA BREWERY CO.,LTD\",\"original_name\":\"株式会社新澤醸造店\",\"website\":\"https://niizawa-brewery.co.jp/\",\"description\":\"創業1873年。創業以来、引き継がれる「愛宕の松」と五代目蔵元が立ち上げた「伯楽星」は“究極の食中酒”をコンセプトに、お料理の味わいを最大限に引き立たせ、ついついもう一杯もう一品と繋がっていく綺麗でフレッシュな酒質を目指しております。 　\\n自社精米から徹底した品質管理のもと醸された渾身の酒は、-5度の氷温貯蔵で厳格に管理され、お客様の口に入る時に最高のコンディションで飲まれることを常に意識しております。 \\n　その品質は世界でも高い評価を得ており「あたごのまつ」は世界一の出品総数を誇る『SAKE COMPETITION』で2016年に純米 酒部門で第一位を獲得。「伯楽星」はJAL国際線ファーストクラスの機内酒に2009年から現在まで連続して搭載されております。 \\n2011年、東日本大震災により三本木蔵は全壊となり、新蔵を蔵王連邦の山間部に移転。澄み切った空気と豊富で良質な地下天然水 の恩恵を受け、より良い製造環境となりました。\\n2018年には史上最年少(当時22歳)の女性杜氏に製造責任者が引き継がれ、更なる品質向上を実現させております。\\n\",\"contacts\":[{\"name\":\"株式会社 新澤醸造店\",\"role\":\"Other\",\"phone\":\"+81229523002\",\"email\":\"competition@niizawa-brewery.co.jp\",\"_id\":\"6796e78f7cbf845e4e85bc36\"},{\"name\":\"山岸憧生\",\"role\":\"Other\",\"phone\":\"+81229523002\",\"email\":\"t.yamagishi@niizawa-brewery.co.jp\",\"_id\":\"6796e78f7cbf845e4e85bc37\"}],\"social\":[],\"brands\":[\"67970ed67cbf845e4e85d10a\",\"6796e78f7cbf845e4e85bc3a\",\"6796e78f7cbf845e4e85bc39\"],\"createdAt\":\"2025-01-27T01:55:27.324Z\",\"updatedAt\":\"2026-01-08T00:41:14.708Z\",\"__v\":0,\"slug\":\"niizawa-brewery-coltd\",\"fax\":\"+81229525226\",\"phone\":\"+81229523002\"},\"type\":\"Sake\",\"eng_name\":\"Sakaba no Junmai Daiginjo\",\"slug\":\"sakaba-no-junmai-daiginjo\",\"force\":0,\"images\":[],\"imageThumbnails\":[],\"made_by\":\"producer\",\"createdAt\":\"2026-03-28T10:19:10.879Z\",\"updatedAt\":\"2026-03-30T04:36:58.236Z\",\"__v\":0,\"sake\":{\"_id\":\"69c7ab1e4184ee76dcfe49f1\",\"user\":\"6786e3ecea5cbc2ecc39694f\",\"product\":\"69c7ab1e4184ee76dcfe49ef\",\"awards\":[],\"eng_name\":\"Sakaba no Junmai Daiginjo\",\"original_name\":\"酒場の純米大吟醸\",\"finishing\":[],\"logistical_info\":[],\"aroma_profile\":[],\"taste_profile\":[],\"food_pairing\":[],\"sake_kakemai\":[],\"sake_kobo\":[],\"sake_kojimai\":[],\"sake_type\":[]