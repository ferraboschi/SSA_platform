":[],\"_id\":\"678dcf5c28711d8ba6075931\",\"user\":\"6786e405ea5cbc2ecc396a63\",\"company\":{\"address\":{\"country\":\"Japan\",\"street\":\"清水町1丁目\",\"number\":\"5-3\",\"city\":\"石巻市\",\"zip\":\"986-0871\",\"state_eng\":\"Miyagi Prefecture\",\"state_original\":\"Miyagi Prefecture\",\"state\":\"Miyagi Prefecture\"},\"made_by\":\"producer\",\"_id\":\"67870e82c30156a03403b00c\",\"user\":\"6786e405ea5cbc2ecc396a63\",\"eng_name\":\" HIRAKOUSHUZOU CO.,LTD.\",\"original_name\":\"株式会社 平孝酒造\",\"phone\":\"+81225220161\",\"phone_country_code\":\"+81\",\"fax\":\"+81225964456\",\"fax_country_code\":\"+81\",\"website\":\"https://www.hirakoushuzou.jp\",\"description\":\"弊社の位置する宮城県石巻市は、昔からの港町で、宮城県金華山沖では暖流と寒流の交わる世界三大漁場の一つとして、四季折々に様々な魚介類が水揚げされます。そういった地域性から「魚でやるなら日髙見だっちゃ!!」をキャッチフレーズに毎年、酒造りに挑んでおります。銘柄の「日髙見（ひたかみ）」は、その昔、太陽の恵みを受ける国「日髙見国」が北上川周辺に存在していた可能性があるという話に因んで命名。日髙見の目指す酒造りは魚介類や鮨に寄り添って、食材や料理を引き立てる事を常に考え、程よい香りと上品な味わいを日々追及しております。\",\"contacts\":[{\"name\":\"及川幸子\",\"role\":\"Other\",\"phone\":\"+81225220161\",\"email\":\"soumu@hitakami.co.jp\",\"_id\":\"67870e82c30156a03403b00d\"}],\"social\":[],\"brands\":[\"67870e82c30156a03403b010\"],\"createdAt\":\"2025-01-15T01:25:22.039Z\",\"updatedAt\":\"2025-12-24T05:43:41.976Z\",\"__v\":0,\"slug\":\"hirakoushuzou-coltd\"},\"type\":\"Sake\",\"eng_name\":\"HITAKAMI TOKUBETSU JUNMAISHU SAKANA LABEL 720ML\",\"force\":0,\"sake\":{\"_id\":\"678dcf5c28711d8ba6075933\",\"user\":\"6786e405ea5cbc2ecc396a63\",\"product\":\"678dcf5c28711d8ba6075931\",\"acidity\":\"1.6\",\"alchool\":\"15\",\"aminoacid\":\"1.2\",\"awards\":[],\"eng_name\":\"HITAKAMI TOKUBETSU JUNMAISHU SAKANA LABEL 720ML\",\"original_name\":\"日高見　特別純米酒　魚ラベル　720ml\",\"finishing\":[],\"logistical_info\":[],\"note\":\"上品で程よい香りと、ふわっと柔らかな膨らみのあるお酒です。\\n「兵庫県産山田錦」のもつ膨らみと、酒造好適米「宮城県産吟のいろは」の柔らかみをお酒で表現させていただきました。\",\"retail_price\":\"1300\",\"retail_price_currency\":\"JPY\",\"aroma_profile\":[{\"value\":\"unripe melon\",\"label\":\" 熟れてないメロン\",\"category\":\"WHITE FRUIT\"},{\"value\":\"unripe pear\",\"l