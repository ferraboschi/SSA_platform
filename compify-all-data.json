se,\"jan_code\":\"4953676623317\",\"has_no_jan_code\":false,\"jan_code_not_reveal\":false,\"polishing_rate\":50,\"sake_meter_value\":6,\"sake_alcohol_level\":14.5,\"nature_of_bubble\":\"\",\"aging_temperature\":\"\",\"special_production_method\":[],\"sake_koji\":[\"yellow\"],\"liqueur_alcohol_type\":\"\",\"liqueur_other_ingredient\":\"\",\"liqueur_sugar_added\":false,\"first_moromi\":[],\"main_ingredients\":[],\"second_ingredients\":[],\"koji\":[]},\"is_busy\":null,\"is_proposed\":null,\"_id\":\"695b74bb9320771a34615203\",\"competition\":{\"_id\":\"69394e2c7ad96d9433c9a373\",\"name\":\"Milano Sake Challenge 2026\",\"slug\":\"msc2026\"},\"user\":{\"firstname_original\":null,\"lastname_original\":null,\"profession_eng\":null,\"profession_original\":null,\"_id\":\"6786e3ebea5cbc2ecc396949\",\"firstname\":\"kaede\",\"lastname\":\"tsunokake\",\"email\":\"seizo@kikunotsukasa.jp\",\"phone\":\"0196933330\",\"phoneCountryCode\":\"+81\",\"password\":\"$2b$10$FxYb0NfxhHYTQVy7tKDoX.DzUd7XJ2NQ.B1gdgNaC/ZQ9IzN02gKy\",\"stripeCustomerId\":\"cus_RaTT4uQDdF0pxa\",\"registeredFromPayment\":true,\"firstPresenceActivated\":true,\"active\":true,\"onboarded\":true,\"type\":\"user\",\"photo\":null,\"roles\":[\"producer\"],\"allowPrivacy\":true,\"allowPromotions\":true,\"createdAt\":\"2025-01-14T22:23:39.485Z\",\"updatedAt\":\"2026-01-04T06:00:57.670Z\",\"__v\":0},\"product\":{\"_id\":\"695b486d2ba8a7bb87cc5f85\",\"user\":\"6786e3ebea5cbc2ecc396949\",\"company\":{\"address\":{\"country\":\"JP\",\"street\":\"雫石\",\"number\":\"11-1\",\"city\":\"雫石町長山\",\"state\":\"岩手県\",\"zip\":\"0200585\",\"state_eng\":\"Iwate\",\"state_original\":\"岩手県\"},\"made_by\":\"producer\",\"_id\":\"67971fb87cbf845e4e85ddb5\",\"user\":\"6786e3ebea5cbc2ecc396949\",\"eng_name\":\"kikunotsukasasyuzou\",\"original_name\":\"菊の司酒造株式会社\",\"website\":\"https://kikunotsukasa.jp\",\"description\":\"菊の司酒造が位置する雫石町は盛岡市に隣接し、岩手山や駒ヶ岳などの美しい峰々に囲まれた町です。かつては宮沢賢治もたびたび雫石町を訪れ、作品にも登場した風景は、\\nイーハトーブの風景地の1つとして国指定名所にもなっています。当蔵では岩手山の伏流水を井戸で汲み上げ、仕込み水として使用しています。岩手の大地に磨かれた水は、適度なミネラル分を含みながらも水質は軟水。\\nこの仕込み水こそ、お米の味わいを引き出し、丁寧に低温発酵させるための当蔵の命の水です。岩手県の気候は、昔からお米が育てにくいといわれる土地でした。夏はやませという冷風が吹き、米を登熱させにくいためです。\\nしかし、長年の研究による品種改良と栽培技術の向上によって、現在では全国と十分に渡り合える品質の優れたお米がたくさん収穫できるようになっています。\\n岩手県の代表する酒米「結の香」「吟ぎんが」「ぎんおとめ」を軸に、当蔵ではお酒造りに使用する原料米の90%以上を地元産のお米を使用しています。\",\"contacts\":[{\"name\":\"Yuhki Omoto\",\"role\":\"Other\",\"phone\":\"+81196933330\",\"email\":\"seizo@kikunotsukasa.jp\",\"_id\":\"695c610d55b25ad10547f93b\"}],\"social\":[],\"brands\":[\"67971fb87cbf845e4e85ddb9\"],\"createdAt\":\"2025-01-27T05:55:04.712Z\",\"updatedAt\":\"2026-01-06T01:10:37.408Z\",\"__v\":0,\"slug\":\"kikunotsukasasyuzou\",\"fax\":\"+81196933335\",\"phone\":\"+81196933330\"},\"type\":\"Sake\",\"eng_name\":\"Niji no Kakehashi\",\"slug\":\"niji-no-kakehashi\",\"force\":0,\"images\":[\"https://storage.googleapis.com/compify-bucket-prod/SAKE/products/695b486d2ba8a7bb87cc5f85/images/1768002740853_nn6qyjylnl_è¹ã®æ¶ãæ©_720ml.png\"],\"imageThumbnails\":[\"https://storage.googleapis.com/compify-bucket-prod/SAKE/products/695b486d2ba8a7bb87cc5f85/images/1768002740853_nn6qyjylnl_è¹ã®æ¶ãæ©_720ml-s.png\"],\"made_by\":\"producer\",\"createdAt\":\"2026-01-05T05:13:17.952Z\",\"updatedAt\":\"2026-01-16T00:36:00.908Z\",\"__v\":0,\"sake\":{\"_id\":\"695b486d2ba8a7bb87cc5f87\",\"user\":\"6786e3ebea5cbc2ecc396949\",\"product\":\"695b486d2ba8a7bb87cc5f85\",\"awards\":[],\"eng_name\":\"Niji no Kakehashi\",\"original_name\":\"虹の架け橋\",\"finishing\":[],\"logistical_info\":[],\"aroma_profile\":[],\"taste_profile\":[],\"food_pairing\":[],\"sake_kakemai\":[],\"sake_kobo\":[],\"sake_kojimai\":[],\"sake_type\":[],\"sake_first_ingredient\":[],\"sake_second_ingredient\":[],\"sake_third_ingredient\":[],\"sake_other_ingredient\":[],\"labels\":[],\"createdAt\":\"2026-01-05T05:13:17.980Z\",\"updatedAt\":\"2026-01-16T00:36:00.898Z\",\"__v\":0},\"original_name\":\"虹の架け橋\"},\"category\":{\"_id\":\"6939c972a01ad75ff2cc787d\",\"name\":\"Junmai\",\"description\":\"J\",\"force