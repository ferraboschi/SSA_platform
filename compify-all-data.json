ったお米を、小川町らしい自然の恵みで杜氏が手間暇を惜しまず丹念に醸して生まれたお酒、それが晴雲です。\\n\",\"contacts\":[{\"name\":\"中山健太郎\",\"role\":\"Other\",\"phone\":\"493720055\",\"email\":\"kentaro.nakayama@zensho.com\",\"_id\":\"6796e5877cbf845e4e85ba96\"},{\"name\":\"藤本 明憲\",\"role\":\"Sales Manager\",\"phone\":\"493720055\",\"email\":\"aki-fujimoto@zensho.com\",\"_id\":\"6796e5877cbf845e4e85ba97\"}],\"social\":[],\"brands\":[\"6796e5877cbf845e4e85ba9b\",\"6796e5877cbf845e4e85ba9c\",\"6796e5877cbf845e4e85ba9a\",\"6796e5877cbf845e4e85ba99\"],\"createdAt\":\"2025-01-27T01:46:47.925Z\",\"updatedAt\":\"2026-01-15T01:31:44.375Z\",\"__v\":0,\"slug\":\"seiun-sake-brewery-coltd\",\"foundation_year\":1902},\"brand\":\"6796e5877cbf845e4e85ba9a\",\"type\":\"Sake\",\"eng_name\":\"Junmai Daiginjo Zensho\",\"force\":0,\"sake\":{\"_id\":\"6796ed0a7cbf845e4e85bf65\",\"user\":\"6786e3edea5cbc2ecc396961\",\"product\":\"6796ed0a7cbf845e4e85bf63\",\"alchool\":\"16\",\"awards\":[{\"competition\":\"ミラノ酒チャレンジ\",\"prize\":\"金\",\"date\":\"2024\"},{\"competition\":\"シンガポール酒チャレンジ\",\"prize\":\"銀\",\"date\":\"2023\"}],\"bottle_depth\":\"7\",\"bottle_height\":\"30\",\"bottle_weight\":\"1.1\",\"bottle_width\":\"7\",\"n_of_bottles\":\"12\",\"box_depth\":\"26.5\",\"box_height\":\"32\",\"box_weight\":\"14.5\",\"box_width\":\"35\",\"eng_name\":\"Junmai Daiginjo Zensho\",\"original_name\":\"純米大吟醸　善祥\",\"finishing\":[],\"logistical_info\":[],\"retail_price\":\"2800\",\"aroma_profile\":[{\"value\":\"citrus fruit\",\"label\":\" citrus fruit\",\"category\":\"CITRUS FRUIT\"},{\"value\":\"yellow grapefruit\",\"label\":\" yellow grapefruit\",\"category\":\"CITRUS FRUIT\"},{\"value\":\"orange peel\",\"label\":\" orange peel\",\"category\":\"CITRUS FRUIT\"},{\"value\":\"lemongrass\",\"label\":\" lemongrass\",\"category\":\"CITRUS FRUIT\"},{\"value\":\"white melon\",\"label\":\" white melon\",\"category\":\"WHITE FRUIT\"}],\"taste_profile\":[{\"value\":\"sweet liquorice\",\"label\":\" sweet liquorice\",\"category\":\"DEVELOPED\"},{\"value\":\"white su