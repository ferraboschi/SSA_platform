":true,\"type\":\"user\",\"photo\":null,\"roles\":[\"producer\"],\"allowPrivacy\":true,\"allowPromotions\":true,\"createdAt\":\"2025-01-14T22:23:21.768Z\",\"updatedAt\":\"2026-01-12T06:45:18.846Z\",\"__v\":0},\"product\":{\"imageThumbnails\":[],\"_id\":\"678c904d28711d8ba6074f7b\",\"user\":\"6786e3d9ea5cbc2ecc396888\",\"company\":{\"address\":{\"country\":\"JP\",\"street\":\"東栄3丁目\",\"number\":\"7-67\",\"city\":\"小千谷市\",\"state\":\"新潟県\",\"zip\":\"947-0004\",\"state_eng\":\"Niigata\",\"state_original\":\"新潟県\"},\"made_by\":\"producer\",\"_id\":\"678b3e9528711d8ba6074538\",\"user\":\"6786e3d9ea5cbc2ecc396888\",\"logo\":\"4e85d710-2fa3-440c-9e47-6dc74694dffd\",\"cover\":\"https://storage.googleapis.com/compify-bucket-prod/SAKE/companies/678b3e9528711d8ba6074538/cover/1768200525431_hc3tc2u7k47_IMG_0058.jpg\",\"eng_name\":\"Takanoi Shuzou Co;Ltd\",\"original_name\":\"高の井酒造株式会社\",\"website\":\"https://hatsuume.co.jp/\",\"description\":\"小千谷市に位置する日本酒の蔵元は、『たかの井』『田友』『元祖雪中貯蔵酒』を醸造しています。この酒蔵では、「和心を通じて、よろこびとうるおいを提供し地域社会に貢献します」という理念を、社員全員で毎朝唱和しています。「和心」とは、日本の伝統・文化を尊重し、共に助け合い幸せに暮らす心を意味します。また、「うるおい」とは、小千谷の自然の恵みを生かした美味しいお酒を通して、地域の魅力を楽しんでもらうことを指しています。この酒蔵は、酒造りを通じ地域発展に貢献し、人々が小千谷の自然や文化、人々と触れ合うきっかけを作ることを目指しています。日本酒を媒介として地域とのつながりを深めることに重きを置いています。\",\"contacts\":[{\"name\":\"明裕 木村\",\"role\":\"Marketing Manager\",\"phone\":\"+81258833450\",\"email\":\"a.kimura@hatsuume.co.jp\",\"_id\":\"678b3e9528711d8ba6074539\"}],\"social\":[],\"brands\":[\"678b3e9528711d8ba607453c\",\"678b3e9528711d8ba607453d\",\"678b3e9528711d8ba607453e\"],\"createdAt\":\"2025-01-18T05:39:33.688Z\",\"updatedAt\":\"2026-01-12T06:53:56.605Z\",\"__v\":0,\"slug\":\"takanoi-shuzou-coltd\",\"coverThumbnail\":\"https://storage.googleapis.com/compify-bucket-prod/SAKE/companies/678b3e9528711d8ba6074538/cover/1768200525431_hc3tc2u7k47_IMG_0058-s.jpg\",\"fax\":\"+81258834495\",\"foundation_year\":1937,\"phone\":\"+81258833450\"},\"type\":\"Sake\",\"eng_name\":\"Denyuu Tokubetsjunmai\",\"force\":0,\"sake\":{\"_id\":\"678c904d287