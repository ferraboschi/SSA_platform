tions\":true,\"createdAt\":\"2025-01-14T22:23:36.549Z\",\"updatedAt\":\"2026-01-14T23:29:28.300Z\",\"__v\":0},\"product\":{\"_id\":\"6968a83d97b75f8e29794740\",\"user\":\"6786e3e8ea5cbc2ecc39692b\",\"company\":{\"address\":{\"country\":\"JP\",\"street\":\"MONZEN\",\"number\":\"713\",\"city\":\"TONE KAWABA\",\"state\":\"GUNMA\",\"zip\":\"3780115\",\"state_eng\":\"Gunma\",\"state_original\":\"群馬県\"},\"made_by\":\"producer\",\"_id\":\"678dcde828711d8ba60758eb\",\"user\":\"6786e3e8ea5cbc2ecc39692b\",\"logo\":\"f0cc8bdc-ffbd-40f8-b175-549f64c453e7\",\"eng_name\":\"NAGAI SAKE INC.\",\"original_name\":\"永井酒造株式会社\",\"phone\":\"278522311\",\"phone_country_code\":\"+81\",\"fax\":\"278522314\",\"fax_country_code\":\"+81\",\"website\":\"https://nagai-sake.co.jp/\",\"description\":\"創業1886年。利根川源流域に位置する群馬県川場村で「地元の自然美を表現するきれいな酒造り」をモットーに“水芭蕉”と“谷川岳”の２銘柄を醸す酒蔵。\\n全国新酒鑑評会では通算18回の金賞を受賞しており、フラッグシップ商品であるスパークリング日本酒「MIZUBASHO PURE」はフランスの一流ソムリエ達が審査を行う国際日本酒コンテスト「Kura Master2024」においてスパークリング部門最高賞の「審査員賞」を受賞。\\n「伝統と革新」をテーマに、スパークリング、スティル、ヴィンテージ、デザートという4種類の日本酒を食事のコースに合わせて楽しむコンセプト 「NAGAI STYLE」を開発。新しい価値観の日本酒「MIZUBASHO Artist Seriesー水芭蕉アーティストシリーズー」を通して、環境保全と女性のエンパワーメント支援、また持続的に地域社会の発展に貢献する為の取り組みを行っております。\",\"contacts\":[{\"name\":\"金井英樹\",\"role\":\"Other\",\"phone\":\"+81278522311\",\"email\":\"h.kanai@mizubashou.co.jp\",\"_id\":\"678dcde828711d8ba60758ec\"}],\"social\":[],\"brands\":[\"678dcde828711d8ba60758ef\",\"678dcde828711d8ba60758f0\"],\"createdAt\":\"2025-01-20T04:15:36.238Z\",\"updatedAt\":\"2026-01-15T01:55:38.083Z\",\"__v\":0,\"slug\":\"nagai-shuzou-kabusikigaisya\"},\"type\":\"Sake\",\"eng_name\":\"MIZUBASHO VINTAGE 2006 DAIGINJO\",\"slug\":\"mizubasho-vintage-2006-daiginjo\",\"force\":0,\"images\":[],\"imageThumbnails\":[],\"made_by\":\"producer\",\"createdAt\":\"2026-01-15T08:41:33.234Z\",\"updatedAt\":\"2026-01-15T08:41:33.234Z\",\"__v\":0,\"sake\":{\"_id\":\"6968a83d97b75f8e29794742\",\"user\":\"6786e3e8ea5cbc2ecc39692b\",\"product\":\"6968a83d97b75f8e29794740\",\"awards\":[],\"eng_n