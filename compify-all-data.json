性杜氏に製造責任者が引き継がれ、更なる品質向上を実現させております。\\n\",\"contacts\":[{\"name\":\"株式会社 新澤醸造店\",\"role\":\"Other\",\"phone\":\"+81229523002\",\"email\":\"competition@niizawa-brewery.co.jp\",\"_id\":\"6796e78f7cbf845e4e85bc36\"},{\"name\":\"山岸憧生\",\"role\":\"Other\",\"phone\":\"+81229523002\",\"email\":\"t.yamagishi@niizawa-brewery.co.jp\",\"_id\":\"6796e78f7cbf845e4e85bc37\"}],\"social\":[],\"brands\":[\"67970ed67cbf845e4e85d10a\",\"6796e78f7cbf845e4e85bc3a\",\"6796e78f7cbf845e4e85bc39\"],\"createdAt\":\"2025-01-27T01:55:27.324Z\",\"updatedAt\":\"2026-01-08T00:41:14.708Z\",\"__v\":0,\"slug\":\"niizawa-brewery-coltd\",\"fax\":\"+81229525226\",\"phone\":\"+81229523002\"},\"category\":{\"_id\":\"6a05ee91c3b09561c7cda9f3\",\"name\":\"San_daniele\",\"description\":\"SD\",\"force\":0},\"session\":{\"_id\":\"69c3105358fb8780cb37ec34\",\"name\":\"Food Pairing\",\"product_type\":\"Food Pairing\"},\"section\":\"\",\"number\":257,\"status\":\"approved\",\"is_completed\":\"2026-06-23T13:23:15.740Z\",\"is_present\":null,\"was_qr_code_downloaded\":false,\"is_design_bonus\":false,\"current_judges\":[],\"current_votes\":7,\"max_votes\":7,\"medals\":[],\"createdAt\":\"2026-06-22T14:55:42.832Z\",\"updatedAt\":\"2026-06-23T13:23:15.734Z\",\"__v\":8,\"table\":{\"_id\":\"6a3a1d920895113beae1161e\",\"competition\":\"69394e2c7ad96d9433c9a373\",\"name\":\"S\",\"bottle_capacity\":50,\"judge_capacity\":30,\"current_judges\":0,\"__v\":0}},{\"extra_competition_data\":{\"finishing\":[],\"no_sale_price\":false,\"price_not_disclosed\":false,\"has_no_jan_code\":false,\"jan_code_not_reveal\":false,\"special_production_method\":[],\"sake_koji\":[],\"first_moromi\":[],\"main_ingredients\":[],\"second_ingredients\":[],\"koji\":[]},\"is_busy\":null,\"is_proposed\":null,\"_id\":\"6a394cee203b9bb0e68f593f\",\"competition\":{\"_id\":\"69394e2c7ad96d9433c9a373\",\"name\":\"Milano Sake Challenge 2026\",\"slug\":\"msc2026\"},\"user\":{\"firstname_original\":null,\"lastname_original\":null,\"profession_eng\":null,\"profession