ssion\":{\"_id\":\"69c3105358fb8780cb37ec34\",\"name\":\"Food Pairing\",\"product_type\":\"Food Pairing\"},\"section\":\"\",\"number\":1071,\"status\":\"approved\",\"is_completed\":\"2026-06-23T10:14:10.544Z\",\"is_present\":null,\"was_qr_code_downloaded\":false,\"is_design_bonus\":false,\"current_judges\":[],\"current_votes\":9,\"max_votes\":9,\"medals\":[],\"createdAt\":\"2026-06-22T14:55:42.798Z\",\"updatedAt\":\"2026-06-23T10:14:10.574Z\",\"__v\":9,\"table\":{\"_id\":\"6a3a2a110895113beaed36bc\",\"competition\":\"69394e2c7ad96d9433c9a373\",\"name\":\"JUN\",\"bottle_capacity\":300,\"judge_capacity\":150,\"current_judges\":0,\"__v\":0}},{\"extra_competition_data\":{\"finishing\":[],\"no_sale_price\":false,\"price_not_disclosed\":false,\"has_no_jan_code\":false,\"jan_code_not_reveal\":false,\"special_production_method\":[],\"sake_koji\":[],\"first_moromi\":[],\"main_ingredients\":[],\"second_ingredients\":[],\"koji\":[]},\"is_busy\":null,\"is_proposed\":null,\"_id\":\"6a394cee203b9bb0e68f58d6\",\"competition\":{\"_id\":\"69394e2c7ad96d9433c9a373\",\"name\":\"Milano Sake Challenge 2026\",\"slug\":\"msc2026\"},\"user\":{\"firstname_original\":null,\"lastname_original\":null,\"profession_eng\":null,\"profession_original\":null,\"_id\":\"6786e3edea5cbc2ecc396961\",\"firstname\":\"健太郎\",\"lastname\":\"中山\",\"email\":\"kentaro.nakayama@zensho.com\",\"phone\":\"0493720055\",\"phoneCountryCode\":\"+81\",\"password\":\"$2b$10$VB34QDcGYHRf2rVnGS/9kuyExG7v1K8kH4fvCSnrc21bvRqR/7p0W\",\"stripeCustomerId\":\"cus_RaTTnzMqQK6Wle\",\"registeredFromPayment\":true,\"firstPresenceActivated\":true,\"active\":true,\"onboarded\":true,\"type\":\"user\",\"photo\":null,\"roles\":[\"producer\"],\"allowPrivacy\":true,\"allowPromotions\":true,\"createdAt\":\"2025-01-14T22:23:41.765Z\",\"updatedAt\":\"2026-01-14T23:31:54.389Z\",\"__v\":0},\"product\":{\"imageThumbnails\":[],\"made_by\":\"producer\",\"_id\":\"6796f5287cbf845e4e85c5c9\",\"user\":\"6786e3edea5cbc2ecc396961\",\"company\":{\"address\":{\"country\":\"JP\",\"street\":\"大塚\",\"number\":\"178-2\",\"city\":\"比企郡小川町\",\"state\":\"埼玉県\",\"zip\":\"355-0328\",\"state_eng\":\"Saitama\",\"state_original\":\"埼玉県\"},\"made_by\":\"producer\",\"_id\":\"6796e5877cbf845e4e85ba95\",\"user\":\"6786e3edea5cbc2ecc396961\",\"cover\":\"f6e005dc-8819-4132-bc4c-f24d8a1456c0\",\"eng_name\":\"Seiun Sake Brewery Co.,Ltd\",\"original_name\":\"晴雲酒造株式会社\",\"phone\":\"493720055\",\"phone_country_code\":\"+81\",\"fax\":\"+81493720311\",\"fax_country_code\":\"+81\",\"website\":\"https://www.seiun-sake.co.jp/\",\"description\":\"1902年の創業以来、小川町の地酒蔵として地域の方々に愛していただけるお酒を念頭に品質にこだわった酒造りを行ってまいりました。\\n埼玉県小川町の地下水は周囲の自然豊かな山々から豊富に供給され、その水質の良さは灘の宮水にも匹敵するとも言われており、盆地特有の冬の冷え込みは吟醸造りに適していることから関東有数の銘醸地、「関東灘」ともよばれています。\\n厳選した原料米だけでなく30年前より地元の無農薬米も使用し、それらの米は自社精米によって、大切に磨かれて酒造りの原料となります。\\n現在のお酒は発酵技術の向上や、繊細な味わいの追求のため、より高度な微生物の生育環境のコントロールが必要不可欠で、丁寧に造ったおいしいお酒の味わいをお客様へお届けするためには、搾ったお酒の貯蔵や瓶詰めなどにおいても同様に細かい気配りが必要です。\\n晴雲酒造ではおいしいお酒をお客様に楽しんで頂くために、まず衛生的な酒造りの環境を整えることが必要不可欠と考え、「清潔」にこだわっています。\\n地域の方が愛情を込めて作ったお米を、小川町らしい自然の恵みで杜氏が手間暇を惜しまず丹念に醸して生まれたお酒、それが晴雲です。\\n\",\"contacts\":[{\"name\":\"中山健太郎\",\"role\":\"Other\",\"phone\":\"493720055\",\"email\":\"kentaro.nakayama@zensho.com\",\"_id\":\"6796e5877cbf845e4e85ba96\"},{\"name\":\"藤本 明憲\",\"role\":\"Sales Manager\",\"phone\":\"493720055\",\"email\":\"aki-fujimoto@zensho.com\",\"_id\":\"6796e5877cbf845e4e85ba97\"}],\"social\":[],\"brands\":[\"6796e5877cbf845e4e85ba9b\",\"6796e5877cbf845e4e85ba9c\",\"6796e5877cbf845e4e85ba9a\",\"6796e5877cbf845e4e85ba99\"],\"createdAt\":\"2025-01-27T01:46:47.925Z\",\"updatedAt\":\"2026-01-15T01:31:44.375Z\",\"__v\":0,\"slug\":\"seiun-sake-brewery-coltd\",\"foundation_year\":1902},\"brand\":\"6796e5877cbf845e4e85ba9c\",\"type\":\"Sake\",\"eng_name\":\"Honjozo Kinsyouzan\",\"force\":0,\"sake\":{\"_id\":\"6796f5287cbf845e4e85c5cb\",\"user\":\"6786e3edea5cbc2ecc396961\",\"product\":\"6796f5287cbf845e4e85c5c9\",\"alchool\":\"15\",\"awards\":[{\"competition\":\"ワイングラスでおいしい日本酒アワード\",\"prize\