\":null,\"_id\":\"6a394cee203b9bb0e68f5965\",\"competition\":{\"_id\":\"69394e2c7ad96d9433c9a373\",\"name\":\"Milano Sake Challenge 2026\",\"slug\":\"msc2026\"},\"user\":{\"firstname_original\":null,\"lastname_original\":null,\"profession_eng\":null,\"profession_original\":null,\"_id\":\"67882cc166ad46e343906b53\",\"firstname\":\"TOSHIYUKI\",\"lastname\":\"YOSHIMURA\",\"email\":\"yoshimura-toshiyuki@toshimaya.co.jp\",\"phone\":\"332939111\",\"phoneCountryCode\":\"+81\",\"password\":\"$2b$10$yvTNxGDIe8CbhPPpAtprq./OQHhV3FTZo5dv3g7ebsAAXGY8e9mnK\",\"stripeCustomerId\":\"cus_Raq6s8WmfQsqjE\",\"registeredFromPayment\":true,\"firstPresenceActivated\":true,\"active\":true,\"onboarded\":true,\"type\":\"user\",\"photo\":null,\"roles\":[\"producer\"],\"allowPrivacy\":true,\"allowPromotions\":false,\"createdAt\":\"2025-01-15T21:46:41.242Z\",\"updatedAt\":\"2026-01-20T03:44:08.695Z\",\"__v\":0},\"product\":{\"_id\":\"696efde9f47886b172bac8cc\",\"user\":\"67882cc166ad46e343906b53\",\"company\":{\"address\":{\"country\":\"JP\",\"street\":\"Kandasarugaku-cho\",\"number\":\"1-5-1\",\"city\":\"Chiyoda-ku\",\"state\":\"Tokyo\",\"zip\":\"1010064\",\"state_eng\":\"Tokyo\",\"state_original\":\"東京都\"},\"made_by\":\"producer\",\"_id\":\"679341ddc3b340b981aed811\",\"user\":\"67882cc166ad46e343906b53\",\"logo\":\"8153934a-17bf-4090-8f50-faa1dfc37258\",\"cover\":\"6aaea12d-7017-4302-87cf-5f3235dd71f0\",\"eng_name\":\"TOSHIMAYA CORPORATION\",\"original_name\":\"株式会社豊島屋本店\",\"phone\":\"+81332939111\",\"phone_country_code\":\"+81\",\"website\":\"https://www.toshimaya.co.jp/en/\",\"description\":\"Toshimaya, the oldest sake store in Tokyo, originated when its founder, Toshimaya Juemon, opened a sake store and tavern in 1596 at Kamakura Waterfront (Uchikanda Chiyoda-ku at present) in central Edo (modern day Tokyo).\\n\\nDuring the Edo era, Toshimaya sold “Kudari-zake”, or sake that had been transported from the Kansai region. Toshimaya sold sake at low prices, and also offered cheap grilled tofu (bean curd) topped with miso paste (“Dengaku” in Japanese), which was a popular snack eaten with sake, and the place is said to have been bustling with people.  Toshimaya is said to have opened the first tavern in Japan.\\n\\nThe company started their sake brewing business in the middle of the Meiji era. At first, the brewery was built in the Nada area in the southern part of Hyogo prefecture. Later, at the beginning of the Showa era, they moved the business to Higashi-Murayama City in west Tokyo. Our premium sake, Kinkon (Golden Wedding Anniversary in English), has been awarded numerous gold prizes at the Annual Japan Sake Awards, and is used as the sacred sake at the famous Meiji Jingu Shrine as well as Kanda Myojin Shrine.\",\"contacts\":[{\"name\":\"Toshiyuki YOSHIMURA\",\"role\":\"CEO\",\"phone\":\"+81332939111\",\"email\":\"yoshimura-toshiyuki@toshimaya.co.jp\",\"_id\":\"679341ddc3b340b981aed812\"}],\"social\":[{\"name\":\"Facebook\",\"link\":\"https://www.facebook.com/toshimaya.co.jp\",\"_id\":\"696efc61f47886b172bac7cc\"},{\"name\":\"Instagram\",\"link\":\"https://www.instagram.com/toshimaya_honten/\",\"_id\":\"696efc61f47886b172bac7cd\"}],\"brands\":[\"679341ddc3b340b981aed816\"],\"createdAt\":\"2025-01-24T07:31:41.206Z\",\"updatedAt\":\"2026-01-20T03:54:09.636Z\",\"__v\":0,\"slug\":\"toshimaya-corporation\",\"fax\":\"+81332939117\",\"foundation_year\":1596},\"type\":\"Sake\",\"eng_name\":\"Kinkon Junmai-Genshu without filtration \\\"JUEMON\\\"\",\"slug\":\"kinkon-junmai-genshu-without-filtration-juemon\",\"force\":0,\"images\":[\"https://storage.googleapis.com/compify-bucket-prod/SAKE/products/696efde9f47886b172bac8cc/images/1768881643018_m8j76h6yq6m_Juemon 720ml.jpg\"],\"imageThumbnails\":[\"https://storage.googleapis.com/compify-bucket-prod/SAKE/products/696efde9f47886b172bac8cc/images/1768881643018_m8j76h6yq6m_Juemon 720ml-s.jpg\"],\"made_by\":\"producer\",\"createdAt\":\"2026-01-20T04:00:41.416Z\",\"updatedAt\":\"2026-01-20T04:00:43.161Z\",\"__v\":0,\