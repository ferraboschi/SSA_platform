杜氏に製造責任者が引き継がれ、更なる品質向上を実現させております。\\n\",\"contacts\":[{\"name\":\"株式会社 新澤醸造店\",\"role\":\"Other\",\"phone\":\"+81229523002\",\"email\":\"competition@niizawa-brewery.co.jp\",\"_id\":\"6796e78f7cbf845e4e85bc36\"},{\"name\":\"山岸憧生\",\"role\":\"Other\",\"phone\":\"+81229523002\",\"email\":\"t.yamagishi@niizawa-brewery.co.jp\",\"_id\":\"6796e78f7cbf845e4e85bc37\"}],\"social\":[],\"brands\":[\"67970ed67cbf845e4e85d10a\",\"6796e78f7cbf845e4e85bc3a\",\"6796e78f7cbf845e4e85bc39\"],\"createdAt\":\"2025-01-27T01:55:27.324Z\",\"updatedAt\":\"2026-01-08T00:41:14.708Z\",\"__v\":0,\"slug\":\"niizawa-brewery-coltd\",\"fax\":\"+81229525226\",\"phone\":\"+81229523002\"},\"type\":\"Sake\",\"eng_name\":\"Serina Junmai Daiginjo\",\"slug\":\"serina-junmai-daiginjo\",\"force\":0,\"images\":[],\"imageThumbnails\":[],\"made_by\":\"producer\",\"createdAt\":\"2026-03-28T10:21:23.746Z\",\"updatedAt\":\"2026-03-30T04:39:22.621Z\",\"__v\":0,\"sake\":{\"_id\":\"69c7aba34184ee76dcfe4ed5\",\"user\":\"6786e3ecea5cbc2ecc39694f\",\"product\":\"69c7aba34184ee76dcfe4ed3\",\"awards\":[],\"eng_name\":\"Serina Junmai Daiginjo\",\"original_name\":\"瀬里奈 純米大吟醸\",\"finishing\":[],\"logistical_info\":[],\"aroma_profile\":[],\"taste_profile\":[],\"food_pairing\":[],\"sake_kakemai\":[],\"sake_kobo\":[],\"sake_kojimai\":[],\"sake_type\":[],\"sake_first_ingredient\":[],\"sake_second_ingredient\":[],\"sake_third_ingredient\":[],\"sake_other_ingredient\":[],\"labels\":[],\"createdAt\":\"2026-03-28T10:21:23.759Z\",\"updatedAt\":\"2026-03-30T04:39:22.604Z\",\"__v\":0},\"original_name\":\"瀬里奈 純米大吟醸\"},\"company\":{\"address\":{\"street\":\"三本木字北町\",\"number\":\"63番地\",\"city\":\"大崎市\",\"state\":\"宮城県\",\"zip\":\"9896321\",\"state_eng\":\"Miyagi\",\"state_original\":\"宮城県\",\"country\":\"JP\"},\"made_by\":\"producer\",\"_id\":\"6796e78f7cbf845e4e85bc35\",\"user\":\"6786e3ecea5cbc2ecc39694f\",\"eng_name\":\"NIIZAWA BREWERY CO.,LTD\",\"original_name\":\"株式会社新澤醸造店\",\"website\":\"https://niizawa-brewery.co.jp/\",\"descriptio