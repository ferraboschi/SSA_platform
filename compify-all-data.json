l\":null,\"_id\":\"6786e3d8ea5cbc2ecc39687c\",\"firstname\":\"Hideyuki\",\"lastname\":\"Goto\",\"email\":\"h-goto@hatsumago.co.jp\",\"phone\":\"0234311515\",\"phoneCountryCode\":\"+81\",\"password\":\"$2b$10$j6URCsgTnkitFfPSfmn/0uEQ9DqXA3G5bcyMmdQHsbFDYcAXG/EHm\",\"stripeCustomerId\":\"cus_RaTTqWxqEzDYZK\",\"registeredFromPayment\":true,\"firstPresenceActivated\":true,\"active\":true,\"onboarded\":true,\"type\":\"user\",\"photo\":null,\"roles\":[\"producer\"],\"allowPrivacy\":true,\"allowPromotions\":true,\"createdAt\":\"2025-01-14T22:23:20.675Z\",\"updatedAt\":\"2026-01-07T04:42:17.424Z\",\"__v\":0},\"product\":{\"_id\":\"6965d1c2d5ced864b87e7557\",\"user\":\"6786e3d8ea5cbc2ecc39687c\",\"company\":{\"address\":{\"country\":\"JP\",\"street\":\"十里塚字村東山\",\"number\":\"125-3\",\"city\":\"酒田市\",\"state\":\"山形県\",\"zip\":\"998-0114\",\"state_eng\":\"Yamagata\",\"state_original\":\"山形県\"},\"made_by\":\"producer\",\"_id\":\"678999d310ef9a5954c84ec7\",\"user\":\"6786e3d8ea5cbc2ecc39687c\",\"eng_name\":\"Tohoku Meijo Co., Ltd.\",\"original_name\":\"東北銘醸株式会社\",\"phone\":\"234311515\",\"phone_country_code\":\"+81\",\"fax\":\"234315588\",\"fax_country_code\":\"+81\",\"website\":\"https://www.hatsumago.co.jp\",\"description\":\"酒田は、江戸時代に「西の堺、東の酒田」と謳われ、海上交通の要所として栄えた港町です。 回船問屋を営んでいた初代佐藤久吉氏が、旧庄内藩酒井家の酒井悌一郎氏から酒造技術を学び、「金久（きんきゅう）」という銘柄を世に送りだし、酒造会社を始めたのは明治26年のことです。昭和のはじめ、当家に長男が誕生したのを機に、みんなに愛され喜ばれるような酒にしたいと願いを込めて、酒名を「初孫」と改めました。\\n\\n初孫の蔵では、創業以来一貫して時間と手間のかかる昔ながらの伝統手法「生酛(きもと)造り」による酒造りを行っています。\\n生酛造りとは清酒酵母以外の微生物の繁殖を抑えるのに空気中の乳酸菌を活用する手法です。長年培われた技術と経験が必要であり、現在生酛で仕込む蔵は全国的にも数少ないとされています。\\n自然界の営みを巧みに誘導する生酛造りにより育成される酵母は醪において健全で旺盛な発酵をもたらします。そのため、力強くしっかりとした酒質と深みのある味わい、すっきりした後口が特長です。\\n\\n初孫は、水と緑に恵まれた環境のもとで、地方の風土が息づく「酒の酒田」ならではの豊かな味わいを継承し、発展させていきます。\",\"contacts\":[{\"name\":\"Hideyuki Goto\",\"role\":\"Operations\",\"phone\":\"234311515\",\"email\":\"h-goto@hatsumago.co.jp\",\"_id\":\"678999d310ef9a5954c84ec8\"},{\"name\":\"Kohei Takeda\",\"role\":\"Operations\",\"phone\":\"234311515\",\"email\":\"k-