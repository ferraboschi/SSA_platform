e Challenge 2026\",\"slug\":\"msc2026\"},\"user\":{\"firstname_original\":null,\"lastname_original\":null,\"profession_eng\":null,\"profession_original\":null,\"_id\":\"6786e3e6ea5cbc2ecc396913\",\"firstname\":\"朋子\",\"lastname\":\"林田\",\"email\":\"wakatakeya.yuco@gmail.com\",\"phone\":\"943722175\",\"phoneCountryCode\":\"+81\",\"password\":\"$2b$10$F9L/J/Q5R54hIb23jbgrLOSfHXpKZMsmxC9.bQ0wc9y418zH6o61S\",\"stripeCustomerId\":\"cus_RaTTC2eLTXUNM8\",\"registeredFromPayment\":true,\"firstPresenceActivated\":true,\"active\":true,\"onboarded\":true,\"type\":\"user\",\"photo\":null,\"roles\":[\"producer\"],\"allowPrivacy\":true,\"allowPromotions\":false,\"createdAt\":\"2025-01-14T22:23:34.397Z\",\"updatedAt\":\"2026-01-19T02:48:23.657Z\",\"__v\":0},\"product\":{\"imageThumbnails\":[],\"_id\":\"6788899a10ef9a5954c83912\",\"user\":\"6786e3e6ea5cbc2ecc396913\",\"company\":{\"address\":{\"country\":\"JP\",\"street\":\"田主丸\",\"number\":\"706\",\"city\":\"久留米市田主丸町\",\"state\":\"福岡県\",\"zip\":\"8391233\",\"state_eng\":\"Fukuoka\",\"state_original\":\"福岡県\"},\"made_by\":\"producer\",\"_id\":\"6788456e10ef9a5954c82ccf\",\"user\":\"6786e3e6ea5cbc2ecc396913\",\"cover\":\"2eb68890-819f-466e-bb0f-5e2a549e2952\",\"eng_name\":\"Wakatakeyashuzoujou\",\"original_name\":\"株式会社若竹屋酒造場\",\"phone\":\"943722175\",\"phone_country_code\":\"+81\",\"fax\":\"943723698\",\"fax_country_code\":\"+81\",\"website\":\"https://wakatakeya.com/\",\"description\":\"今から遡ること326年、初代伝兵衛は地域の人々とともに田主丸に酒蔵を造りました。\\n14代目となる現蔵元は初代伝兵衛の酒造りに対する想いを受け継ぎ、いつの時代も皆さまに楽しんでもらえるこだわりのお酒を造り続けています。\\n若竹屋には「若竹屋は先祖より受け継ぎし商いにあらず、子孫より預かりしものなり」という代々受け継がれてきた家訓があります。\\n技術やお客さまは保守的に受け継いでいるものではなく、常にお客さまのご要望に応え革新すべきものであり、また、田主丸のすばらしい自然環境は預かりものだからこそ、これから先も恵みを受けることができるように本来の自然の姿のまま子孫へ「還す」という意味が込められています。\\n代々受け継がれし家訓を守り、私たちは田主丸の自然環境、お米の生産農家の方々、販売店の方々、そして何より若竹屋をご愛顧頂いているお客さまと共に、さらに300年日本酒を造り続けることができる蔵として邁進して参ります。\",\"contacts\":[{\"name\":\"朋子 林田\",\"role\":\"Operations\",\"phone\":\"943722175\",\"phone_country_code\":\"+81\",\"email\":\"wakatakeya