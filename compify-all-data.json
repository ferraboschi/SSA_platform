4e2c7ad96d9433c9a373\",\"name\":\"F/H\",\"bottle_capacity\":50,\"judge_capacity\":30,\"current_judges\":0,\"__v\":0}},{\"extra_competition_data\":{\"finishing\":[],\"no_sale_price\":false,\"price_not_disclosed\":false,\"has_no_jan_code\":false,\"jan_code_not_reveal\":false,\"special_production_method\":[],\"sake_koji\":[],\"first_moromi\":[],\"main_ingredients\":[],\"second_ingredients\":[],\"koji\":[]},\"is_busy\":null,\"is_proposed\":null,\"_id\":\"6a394cee203b9bb0e68f58e8\",\"competition\":{\"_id\":\"69394e2c7ad96d9433c9a373\",\"name\":\"Milano Sake Challenge 2026\",\"slug\":\"msc2026\"},\"user\":{\"firstname_original\":null,\"lastname_original\":null,\"profession_eng\":null,\"profession_original\":null,\"_id\":\"6786e3ecea5cbc2ecc39694f\",\"firstname\":\"株式会社\",\"lastname\":\"新澤醸造店\",\"email\":\"competition@niizawa-brewery.co.jp\",\"phone\":\"0229523002\",\"phoneCountryCode\":\"+81\",\"password\":\"$2b$10$3VzJP1UacIgu68bP9.QMtOLYo9OIwzHdXM1sxIqNCClrdZTF/lfJm\",\"stripeCustomerId\":\"cus_RaTTURiUCBJWHF\",\"registeredFromPayment\":true,\"firstPresenceActivated\":true,\"active\":true,\"onboarded\":true,\"type\":\"user\",\"photo\":null,\"roles\":[\"producer\"],\"allowPrivacy\":true,\"allowPromotions\":true,\"createdAt\":\"2025-01-14T22:23:40.065Z\",\"updatedAt\":\"2026-01-07T07:21:06.170Z\",\"__v\":0},\"product\":{\"imageThumbnails\":[],\"made_by\":\"producer\",\"_id\":\"67971cd97cbf845e4e85dc63\",\"user\":\"6786e3ecea5cbc2ecc39694f\",\"company\":{\"address\":{\"street\":\"三本木字北町\",\"number\":\"63番地\",\"city\":\"大崎市\",\"state\":\"宮城県\",\"zip\":\"9896321\",\"state_eng\":\"Miyagi\",\"state_original\":\"宮城県\",\"country\":\"JP\"},\"made_by\":\"producer\",\"_id\":\"6796e78f7cbf845e4e85bc35\",\"user\":\"6786e3ecea5cbc2ecc39694f\",\"eng_name\":\"NIIZAWA BREWERY CO.,LTD\",\"original_name\":\"株式会社新澤醸造店\",\"website\":\"https://niizawa-brewery.co.jp/\",\"description\":\"創業1873年。創業以来、引き継がれる「愛宕の松」と五代目蔵元が立ち上げた「伯楽星」は“究極の食中酒”をコンセプトに、お料理の味わいを最大限に引き立たせ、ついついもう一杯もう一品と繋がっていく綺麗でフレッシュな酒質を目指しております。 　\\n自社精米から徹底した品質管理のもと醸された渾身の酒は、-5度の氷温貯蔵で厳格に管理され、お客様の口に入る時に最高のコンディションで飲まれることを常に意識しております。 \\n　その品質は世界でも高い評価を得ており「あたごのまつ」は世界一の出品総数を誇る『SAKE COMPETITION』で2016年に純米 酒部門で第一位を獲得。「伯楽星」はJAL国際線ファーストクラスの機内酒に2009年から現在まで連続して搭載されております。 \\n2011年、東日本大震災により三本木蔵は全壊となり、新蔵を蔵王連邦の山間部に移転。澄み切った空気と豊富で良質な地下天然水 の恩恵を受け、より良い製造環境となりました。\\n2018年には史上最年少(当時22歳)の女性杜氏に製造責任者が引き継がれ、更なる品質向上を実現させております。\\n\",\"contacts\":[{\"name\":\"株式会社 新澤醸造店\",\"role\":\"Other\",\"phone\":\"+81229523002\",\"email\":\"competition@niizawa-brewery.co.jp\",\"_id\":\"6796e78f7cbf845e4e85bc36\"},{\"name\":\"山岸憧生\",\"role\":\"Other\",\"phone\":\"+81229523002\",\"email\":\"t.yamagishi@niizawa-brewery.co.jp\",\"_id\":\"6796e78f7cbf845e4e85bc37\"}],\"social\":[],\"brands\":[\"67970ed67cbf845e4e85d10a\",\"6796e78f7cbf845e4e85bc3a\",\"6796e78f7cbf845e4e85bc39\"],\"createdAt\":\"2025-01-27T01:55:27.324Z\",\"updatedAt\":\"2026-01-08T00:41:14.708Z\",\"__v\":0,\"slug\":\"niizawa-brewery-coltd\",\"fax\":\"+81229525226\",\"phone\":\"+81229523002\"},\"brand\":\"6796e78f7cbf845e4e85bc3a\",\"type\":\"Sake\",\"eng_name\":\"Atagonomatsu Senretsukarakuchi\",\"force\":0,\"sake\":{\"_id\":\"67971cd97cbf845e4e85dc65\",\"user\":\"6786e3ecea5cbc2ecc39694f\",\"product\":\"67971cd97cbf845e4e85dc63\",\"alchool\":\"15\",\"awards\":[],\"eng_name\":\"Atagonomatsu Senretsukarakuchi\",\"original_name\":\"あたごのまつ 鮮烈辛口\",\"finishing\":[],\"logistical_info\":[],\"retail_price\":\"1599\",\"aroma_profile\":[],\"taste_profile\":[],\"food_pairing\":[],\"sake_kakemai\":[],\"sake_kakemai_seimai_buai\":\"70\",\"sake_kobo\":[],\"sake_kojimai\":[],\"sake_kojimai_seimai_buai\":\"70\",\"sake_type\":[{\"value\":\"honjozo\",\"label\":\"本醸造\"}],\"sake_first_ingredient\":[],\"sake_second_ingredient\":[],\"sake_third_ingredient\":[],\"sake_other_ingredient\":[],\"labels\":[],\"createdAt\":\"2025-01-27T05:42:49.170Z\",\"updatedAt\":\"2026-01-08T08:54:03.498Z\",\"__v\":0},\"createdAt\":\"2025-01-27T05:42:49.165Z\",\"updatedAt\":\"2026-01-08T08:54:03.502Z\",\"section\":