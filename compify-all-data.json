ng\":null,\"profession_original\":null,\"_id\":\"6786e3ebea5cbc2ecc396949\",\"firstname\":\"kaede\",\"lastname\":\"tsunokake\",\"email\":\"seizo@kikunotsukasa.jp\",\"phone\":\"0196933330\",\"phoneCountryCode\":\"+81\",\"password\":\"$2b$10$FxYb0NfxhHYTQVy7tKDoX.DzUd7XJ2NQ.B1gdgNaC/ZQ9IzN02gKy\",\"stripeCustomerId\":\"cus_RaTT4uQDdF0pxa\",\"registeredFromPayment\":true,\"firstPresenceActivated\":true,\"active\":true,\"onboarded\":true,\"type\":\"user\",\"photo\":null,\"roles\":[\"producer\"],\"allowPrivacy\":true,\"allowPromotions\":true,\"createdAt\":\"2025-01-14T22:23:39.485Z\",\"updatedAt\":\"2026-01-04T06:00:57.670Z\",\"__v\":0},\"product\":{\"_id\":\"67972be37cbf845e4e85e923\",\"user\":\"6786e3ebea5cbc2ecc396949\",\"company\":{\"address\":{\"country\":\"JP\",\"street\":\"雫石\",\"number\":\"11-1\",\"city\":\"雫石町長山\",\"state\":\"岩手県\",\"zip\":\"0200585\",\"state_eng\":\"Iwate\",\"state_original\":\"岩手県\"},\"made_by\":\"producer\",\"_id\":\"67971fb87cbf845e4e85ddb5\",\"user\":\"6786e3ebea5cbc2ecc396949\",\"eng_name\":\"kikunotsukasasyuzou\",\"original_name\":\"菊の司酒造株式会社\",\"website\":\"https://kikunotsukasa.jp\",\"description\":\"菊の司酒造が位置する雫石町は盛岡市に隣接し、岩手山や駒ヶ岳などの美しい峰々に囲まれた町です。かつては宮沢賢治もたびたび雫石町を訪れ、作品にも登場した風景は、\\nイーハトーブの風景地の1つとして国指定名所にもなっています。当蔵では岩手山の伏流水を井戸で汲み上げ、仕込み水として使用しています。岩手の大地に磨かれた水は、適度なミネラル分を含みながらも水質は軟水。\\nこの仕込み水こそ、お米の味わいを引き出し、丁寧に低温発酵させるための当蔵の命の水です。岩手県の気候は、昔からお米が育てにくいといわれる土地でした。夏はやませという冷風が吹き、米を登熱させにくいためです。\\nしかし、長年の研究による品種改良と栽培技術の向上によって、現在では全国と十分に渡り合える品質の優れたお米がたくさん収穫できるようになっています。\\n岩手県の代表する酒米「結の香」「吟ぎんが」「ぎんおとめ」を軸に、当蔵ではお酒造りに使用する原料米の90%以上を地元産のお米を使用しています。\",\"contacts\":[{\"name\":\"Yuhki Omoto\",\"role\":\"Other\",\"phone\":\"+81196933330\",\"email\":\"seizo@kikunotsukasa.jp\",\"_id\":\"695c610d55b25ad10547f93b\"}],\"social\":[],\"brands\":[\"67971fb87cbf845e4e85ddb9\"],\"createdAt\":\"2025-01-27T05:55:04.712Z\",\"updatedAt\":\"2026-01-06T01:10:37.408Z\",\"__v\":0,\"slug\":\"kikunotsukasasyuzou\",\"fax\":\"+81196933335\",\"phone\":\"+81196933330\"},\"type\":\"Sake\"