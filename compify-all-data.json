ail\":\"keith_inoue@thermoline.jp\",\"phone\":\"09042472875\",\"phoneCountryCode\":\"+81\",\"password\":\"$2b$10$hL.Mndys97WmeV7qGR4yhekAAXp6OTf/OKFX4ZHEY2gQ73Z/4RXPe\",\"stripeCustomerId\":\"cus_S0GSkN61aLlOuP\",\"registeredFromPayment\":true,\"firstPresenceActivated\":true,\"active\":true,\"onboarded\":true,\"type\":\"user\",\"photo\":null,\"roles\":[\"producer\"],\"allowPrivacy\":true,\"allowPromotions\":true,\"createdAt\":\"2025-03-24T18:40:40.868Z\",\"updatedAt\":\"2026-01-13T12:12:43.714Z\",\"__v\":0},\"product\":{\"_id\":\"69d4d3bb36e26c484f14da82\",\"user\":\"67e1a7282abe09b4d84997c8\",\"company\":{\"address\":{\"street\":\"Azabujyuban\",\"number\":\"1-2-7-701\",\"city\":\"Minato-ku\",\"state\":\"Tokyo\",\"zip\":\"1060045\",\"state_eng\":\"Tokyo\",\"state_original\":\"東京都\",\"country\":\"JP\"},\"made_by\":\"producer\",\"_id\":\"67e1da183968759cd54b3ccc\",\"user\":\"67e1a7282abe09b4d84997c8\",\"eng_name\":\"THERMOLINE CO.,LTD.\",\"original_name\":\"株式会社サーモライン\",\"phone\":\"+81358776784\",\"phone_country_code\":\"+81\",\"fax\":\"+81358776784\",\"fax_country_code\":\"+81\",\"website\":\"https://thermoline.jp\",\"description\":\"Thermoline Co., Ltd., established in 2016 and headquartered in Tokyo, Japan, is a specialized trading company currently dedicated to introducing the exceptional local sake \\\"Kunpeki\\\" to the global market. Its founder, Mr. Inoue, has extensive international trading experience in the semiconductor industry. Driven by his passion for sake, he became a certified sake sommelier (Kikisake-shi) and gained firsthand experience and knowledge about Kunpeki sake at Kunpeki Brewery, located near Nagoya City in Aichi Prefecture. Following this experience, Thermoline began selling sake in early spring 2025.\\n\\nIn 2025, Thermoline proudly presents the sake \\\"Kunpeki,\\\" crafted meticulously and wholeheartedly by the skilled master brewers (Toji) at Kunpeki Brewery. Kunpeki Brewery is renowned for its meticulous craftsmanship and unwavering dedication to quality, embodying the true essence of traditional sake brewing. Their exceptional brewing technique was demonstrated by winning a Gold Award at Japan's National New Sake Appraisal in 2024, affirming the superior quality of Kunpeki sake. Through participation in the Milano Sake Challenge, Thermoline aims to introduce Kunpeki's delicate flavors to Italy's sophisticated palate, fostering cultural exchange and deepening appreciation through Japan's beloved beverage.\\n\\n\",\"contacts\":[{\"name\":\"Katsuya Inoue\",\"role\":\"Owner\",\"phone\":\"+819042472875\",\"email\":\"keith_inoue@thermoline.jp\",\"_id\":\"69e1553e4078527678e536bd\"}],\"social\":[],\"brands\":[\"67ea295b384e785433990b50\"],\"createdAt\":\"2025-03-24T22:18:00.261Z\",\"updatedAt\":\"2026-04-16T21:31:42.408Z\",\"__v\":0,\"slug\":\"thermoline-coltd\",\"foundation_year\":2016},\"type\":\"Sake\",\"eng_name\":\"Kunpeki Tokubetsu Jyunmaishu\",\"slug\":\"kunpeki-tokubetsu-jyunmaishu\",\"force\":0,\"images\":[\"https://storage.googleapis.com/compify-bucket-prod/SAKE/products/69d4d3bb36e26c484f14da82/images/1776376150534_8645eth2eb3_ç¹å¥ç´ç±³éR.png\"],\"imageThumbnails\":[\"https://storage.googleapis.com/compify-bucket-prod/SAKE/products/69d4d3bb36e26c484f14da82/images/1776376150534_8645eth2eb3_ç¹å¥ç´ç±³éR-s.png\"],\"made_by\":\"producer\",\"createdAt\":\"2026-04-07T09:51:55.129Z\",\"updatedAt\":\"2026-04-16T21:49:10.724Z\",\"__v\":0,\"sake\":{\"_id\":\"69d4d3bb36e26c484f14da84\",\"user\":\"67e1a7282abe09b4d84997c8\",\"product\":\"69d4d3bb36e26c484f14da82\",\"awards\":[],\"eng_name\":\"Kunpeki Tokubetsu Jyunmaishu\",\"original_name\":\"\",\"finishing\":[],\"logistical_info\":[],\"aroma_profile\":[],\"taste_profile\":[],\"food_pairing\":[],\"sake_kakemai\":[],\"sake_kobo\":[],\"sake_kojimai\":[],\"sake_type\":[],\"sake_first_ingredient\":[],\"sake_second_ingredient\":[],\"sake_third_ingredient\":[],\"sake_other_ingredient\":[],\"labels\":[],\"createdAt\":\"2026-04-07T09:51:55.162Z\",\"upd