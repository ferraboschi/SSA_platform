{\"type\":\"Sake\",\"competition_category\":\"6939c972a01ad75ff2cc7879\",\"product_type_detail\":\"\",\"finishing\":[],\"price\":1800,\"currency\":\"JPY\",\"no_sale_price\":false,\"price_not_disclosed\":false,\"jan_code\":\"4935717285616\",\"has_no_jan_code\":false,\"jan_code_not_reveal\":false,\"polishing_rate\":59,\"sake_meter_value\":-12,\"sake_alcohol_level\":13.9,\"nature_of_bubble\":\"\",\"aging_temperature\":\"\",\"special_production_method\":[],\"sake_koji\":[\"yellow\"],\"liqueur_alcohol_type\":\"\",\"liqueur_other_ingredient\":\"\",\"liqueur_sugar_added\":false,\"first_moromi\":[],\"main_ingredients\":[],\"second_ingredients\":[],\"koji\":[]},\"is_busy\":null,\"is_proposed\":null,\"_id\":\"698292c829f9ffb48a06fb60\",\"competition\":{\"_id\":\"69394e2c7ad96d9433c9a373\",\"name\":\"Milano Sake Challenge 2026\",\"slug\":\"msc2026\"},\"user\":{\"firstname_original\":null,\"lastname_original\":null,\"profession_eng\":null,\"profession_original\":null,\"_id\":\"6786389407e0e1ef295fb189\",\"firstname\":\"HIDESABURO\",\"lastname\":\"ENDO\",\"email\":\"info@keiryu.jp\",\"phone\":\"9030898646\",\"phoneCountryCode\":\"+81\",\"password\":\"$2b$10$5BWz5b87UqJKLMDsUr4WVeFOPoHkUmySug227Rn/Ne27qZiKe6ci.\",\"stripeCustomerId\":\"cus_RaHgqGts39gFAZ\",\"registeredFromPayment\":true,\"firstPresenceActivated\":true,\"active\":true,\"onboarded\":true,\"type\":\"user\",\"photo\":null,\"roles\":[\"producer\"],\"allowPrivacy\":true,\"allowPromotions\":true,\"createdAt\":\"2025-01-14T10:12:36.162Z\",\"updatedAt\":\"2026-02-03T09:39:13.083Z\",\"__v\":0},\"product\":{\"_id\":\"698292c429f9ffb48a06fb04\",\"user\":\"6786389407e0e1ef295fb189\",\"company\":{\"address\":{\"country\":\"JP\",\"street\":\"Ooaza-Suzaka\",\"number\":\"29\",\"city\":\"Suzaka-City\",\"state\":\"Suzaka-City\",\"zip\":\"3820000\",\"state_eng\":\"Nagano\",\"state_original\":\"長野県\"},\"made_by\":\"producer\",\"_id\":\"6792d1c87ca904179fda4c38\",\"user\":\"6786389407e0e1ef295fb189\",\"logo\":\"9a67377e-a719-41ff-a453-cebbf1858042\",\"cover\":\"eb2e4db6-beba-4f1a-ac54-52fe708a70c0\",\"eng_name\":\"ENDO BREWERY Inc.\",\"original_name\":\"\",\"phone\":\"262450117\",\"phone_country_code\":\"+81\",\"fax\":\"262451477\",\"fax_country_code\":\"+81\",\"website\":\"www.keiryu.jp\",\"description\":\"Endo Brewery is located 2-3 minutes from Garyu Park, designated as “One of Japan’s Top 100 Cherry Blossom Viewing Sites” in Shinshu Suzaka.\\nThe brewery founded  in 1864 in the Edo Period as a brewer of fine Sake, and provider to the Lord Suzaka feudal clan. Endo Brewery has continued on its tradition under the philosophy of its founder Tokusaburo Endo, the first brew master “brewing the best Sake”. Based on the brew master’s creed of “Sake is created and cultivated ” of which the select Sake “Keiryu” was born. \\nThere is a lot of beautiful nature and fresh air, above all clean water in Suzaka. We love this land and We keep putting our whole heart and soul into sake brewing forever.\\nThe sake, which draws out the flavor of the rice, quickly received consumer support and became the second largest sake brewery in Nagano prefecture.\\nDuring that time, he won the 11th Gold Prize at the National New Sake Appraisal, 20 times the Nagano Prefectural Governor's Award, 12 times the Excellence Award at the Kanto Shinetsu National Taxation Bureau Liquor Competition, the Monde Selection Grand Gold Prize, and the INTERNATIONAL TASTE & QUALITY INSTITUTE. It has become the ultimate sake that has been recognized by the world in terms of quality, such as winning the first Crystal Award and the gold medal at the International Wine Competition IWC.\\nWe have been featured in the mass media and introduced as a lively brewery in TV, radio, and newspapers. Its popularity continues with the Sake Brewery Festival held every year in the third week of April, with 35,000 fans visiting and enjoying it. This year as well, the brewers enter with the arrival of the season when the flowers dance, and the brewery is filled with the shouts of the brewers. This scene has continued for many years since 1864, when the company was founded.\",\"contacts\":[{\"name\":\"HIDESABURO ENDO\",\"phone\":\"262450117\",\"phone_country_code\":\"+81\",\"email\":\"info@keiryu.jp\",\"_id\":\"6792d1c87ca904179fda4c39\"},{\"name\":\"\",\"phone\":\"\",\"email\":\"\",\"_id\":\"6792d1c87ca904179fda4c3a\"}],\"social\":[],\"brands\":[\"6792d1c87ca904179fda4c3c\"],\"createdAt\":\"2025-01-23T23:33:28.345Z\",\"updatedAt\":\"2025-01-23T23:33:28.345Z\",\"__v\":0,\"slug\":\"endo-brewery-inc\"},\"type\":\"Sake\",\"eng_name\":\"NAOTORA TAGUSAKE JUNMAIGINJO\",\"slug\":\"naotora-tagusake-junmaiginjo\",\"force\":0,\"images\":[\"https://storage.googleapis.com/compify-bucket-prod/SAKE/products/698292c429f9ffb48a06fb04/images/1770164935002_lzgg1e35lcr_ç´èã¿ã¯ãé720.jpg\"],\"imageThumbnails\":[\"https://storage.googleapis.com/compify-bucket-prod/SAKE/products/698292c429f9ffb48a06fb04/images/1770164935002_lzgg1e35lcr_ç´èã¿ã¯ãé720-s.jpg\"],\"made_by\":\"producer\",\"createdAt\":\"2026-02-04T00:28:52.777Z\",\"updatedAt\":\"2026-02-04T00:28:55.289Z\",\"__v\":0,\"sake\":{\"_id\":\"698292c429f9ffb48a06fb06\",\"user\":\"6786389407e0e1ef295fb189\",\"product\":\"698292c429f9ffb48a06fb04\",\"awards\":[],\"eng_name\":\"NAOTORA TAGUSAKE JUNMAIGINJO\",\"original_name\":\"\",\"finishing\":[],\"logistical_info\":[],\"aroma_profile\":[],\"taste_profile\":[],\"food_pairing\":[],\"sake_kakemai\":[],\"sake_kobo\":[],\"sake_kojimai\":[],\"sake_type\":[],\"sake_first_ingredient\":[],\"sake_second_ingredient\":[],\"sake_third_ingredient\":[],\"sake_other_ingredient\":[],\"labels\":[],\"createdAt\":\"2026-02-04T00:28:52.812Z\",\"updatedAt\":\"2026-02-04T00:28:52.812Z\",\"__v\":0}},\"company\":{\"address\":{\"country\":\"JP\",\"street\":\"Ooaza-Suzaka\",\"number\":\"29\",\"city\":\"Suzaka-City\",\"state\":\"Suzaka-City\",\"zip\":\"3820000\",\"state_eng\":\"Nagano\",\"state_original\":\"長野県\"},\"made_by\":\"producer\",\"_id\":\"679